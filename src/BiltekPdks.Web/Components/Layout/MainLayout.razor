@inherits LayoutComponentBase

<div class="d-flex flex-column vh-100">
    <nav class="ust-menu d-flex align-items-center px-3 gap-1">
        <a class="marka me-3" href="">Biltek PDKS</a>
        <NavLink class="menu-ogesi" href="" Match="NavLinkMatch.All">Ana ekran</NavLink>
        <div class="menu-grubu">
            <span class="menu-ogesi">Tanımlar ▾</span>
            <div class="menu-alt">
                <a href="tanimlar/bolum">Personel Genel Tanımlar (Bölüm, Görev, Servis, Bölge)</a>
                <span class="yakinda">Kullanıcı Tanımlama</span>
                <span class="yakinda">Firma İşlemleri</span>
                <hr />
                <span class="yakinda">Kapı-Terminal Tanımları</span>
                <span class="yakinda">Yetki Tanımları</span>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Toplu İşlemler ▾</span>
            <div class="menu-alt">
                <a href="toplu/giris-cikis">Toplu Giriş-Çıkış Ekle</a>
                <span class="yakinda">Toplu İzin Ekleme</span>
                <span class="yakinda">Toplu Kazanç-Kesinti Ekle</span>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">İşlemler ▾</span>
            <div class="menu-alt">
                <span class="yakinda">Terminalden Bilgi Aktar PDKS</span>
                <a href="puantaj/toplu">Puantaj Hesapla</a>
                <hr />
                <a href="personeller">Personel Listesi</a>
                <a href="personeller/yeni">Yeni Personel</a>
