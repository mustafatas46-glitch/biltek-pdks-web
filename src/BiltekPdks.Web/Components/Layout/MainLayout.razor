@inherits LayoutComponentBase

<div class="d-flex flex-column vh-100">
    <nav class="ust-menu d-flex align-items-center px-3 gap-1">
        <a class="marka me-3" href="">Biltek PDKS</a>
        <NavLink class="menu-ogesi" href="" Match="NavLinkMatch.All">Ana ekran</NavLink>
        <div class="menu-grubu">
            <span class="menu-ogesi">Tanımlar ▾</span>
            <div class="menu-alt">
                <a href="tanimlar/sube">Şubeler</a>
                <a href="tanimlar/bolum">Bölümler</a>
                <a href="tanimlar/gorev">Görevler</a>
                <a href="tanimlar/grup">Çalışma grupları</a>
                <a href="tanimlar/izin">İzin türleri</a>
                <hr />
                <a href="vardiyalar">Vardiyalar</a>
                <a href="calisma-plani">Haftalık çalışma planı</a>
                <a href="resmi-tatiller">Resmi tatiller</a>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">İşlemler ▾</span>
            <div class="menu-alt">
                <a href="personeller">Personel listesi</a>
                <a href="personeller/yeni">Yeni personel</a>
                <hr />
                <a href="hareketler">Giriş-çıkış hareketleri</a>
                <a href="izinler">İzinler</a>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Raporlar ▾</span>
            <div class="menu-alt">
                <a href="puantaj/toplu">Toplu aylık puantaj</a>
                <a href="puantaj">Kişisel aylık puantaj</a>
                <a href="ozet">Özet</a>
            </div>
        </div>
        <div class="ms-auto d-flex align-items-center gap-2">
            <AuthorizeView>
                <span class="small text-white-50">@context.User.Identity?.Name</span>
                <a class="btn btn-sm btn-outline-light" href="hesap/sifre">Şifre</a>
                <form method="post" action="hesap/cikis">
                    <AntiforgeryToken />
                    <button class="btn btn-sm btn-outline-light" type="submit">Çıkış</button>
                </form>
            </AuthorizeView>
        </div>
    </nav>
    <main class="sayfa flex-grow-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    Beklenmeyen bir hata oluştu.
    <a href="" class="reload">Yenile</a>
    <a class="dismiss">🗙</a>
</div>
