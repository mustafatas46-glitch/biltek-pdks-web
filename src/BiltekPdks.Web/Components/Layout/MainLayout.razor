@inherits LayoutComponentBase

<div class="d-flex flex-column vh-100">
    <nav class="ust-menu d-flex align-items-center px-3 gap-1">
        <a class="marka me-3" href="">Biltek PDKS</a>
        <NavLink class="menu-ogesi" href="" Match="NavLinkMatch.All">Ana ekran</NavLink>
        <div class="menu-grubu">
            <span class="menu-ogesi">Tanımlar ▾</span>
            <div class="menu-alt">
                <YetkiliBaglanti Yetki="@Yetkiler.TanimDuzenle" Href="tanimlar/bolum">Personel Genel Tanımlar (Bölüm, Görev, Servis, Bölge)</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.KullaniciYonetimi" Href="tanimlar/kullanicilar">Kullanıcı Tanımlama</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@SistemYetkisi.Ad" Href="sistem/firmalar">Firma İşlemleri (bulut)</YetkiliBaglanti>
                <hr />
                <span class="yakinda">Kapı-Terminal Tanımları</span>
                <span class="yakinda">Yetki Tanımları</span>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Toplu İşlemler ▾</span>
            <div class="menu-alt">
                <YetkiliBaglanti Yetki="@Yetkiler.HareketDuzenle" Href="toplu/giris-cikis">Toplu Giriş-Çıkış Ekle</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.IzinDuzenle" Href="toplu/izin">Toplu İzin Ekleme</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.KazancKesintiDuzenle" Href="toplu/kazanc-kesinti">Toplu Kazanç-Kesinti Ekle</YetkiliBaglanti>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">İşlemler ▾</span>
            <div class="menu-alt">
                <span class="yakinda">Terminalden Bilgi Aktar PDKS</span>
                <YetkiliBaglanti Yetki="@Yetkiler.PuantajGor" Href="puantaj/toplu">Puantaj Hesapla</YetkiliBaglanti>
                <hr />
                <YetkiliBaglanti Yetki="@Yetkiler.PersonelGor" Href="personeller">Personel Listesi</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.PersonelDuzenle" Href="personeller/yeni">Yeni Personel</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.HareketDuzenle" Href="hareketler">Giriş-Çıkış Hareketleri</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.IzinDuzenle" Href="izinler">İzinler</YetkiliBaglanti>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Hesap Parametreleri ▾</span>
            <div class="menu-alt">
                <YetkiliBaglanti Yetki="@Yetkiler.HesapParametreleri" Href="grup-tanimlama">Grup Tanımlama (Dönem, Resmi Tatil, Çalışma Planı)</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.HesapParametreleri" Href="vardiyalar">Günlük Çalışma Saatleri (Puantaj Parametreleri)</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.HesapParametreleri" Href="vardiyalar?sekme=mola">Mola Saatleri</YetkiliBaglanti>
                <span class="yakinda">Grup Özel / Kişisel Çalışma Planı</span>
                <hr />
                <YetkiliBaglanti Yetki="@Yetkiler.TanimDuzenle" Href="tanimlar/izin">Bordro Alan Türleri — İzin</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.TanimDuzenle" Href="tanimlar/kazanc-kesinti">Bordro Alan Türleri — Kazanç / Kesinti</YetkiliBaglanti>
                <span class="yakinda">Genel Ayarlar (puantaj, kesinti, ceza, yuvarlama)</span>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Raporlar ▾</span>
            <div class="menu-alt">
                <YetkiliBaglanti Yetki="@Yetkiler.PuantajGor" Href="ozet">Puantaj Sonuçları (Günlük)</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.PuantajGor" Href="puantaj/toplu">Puantaj Sonuçları (Aylık)</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.PuantajGor" Href="puantaj">Kişisel Puantaj</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.UcretGor" Href="raporlar/maas-pusulasi">Maaş Pusulası</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.UcretGor" Href="raporlar/bordro-uyum">Bordro–PDKS Uyum Raporu</YetkiliBaglanti>
                <hr />
                <YetkiliBaglanti Yetki="@Yetkiler.PersonelGor" Href="personeller">Personel Listesi</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.HareketDuzenle" Href="hareketler">Giriş-Çıkış Listesi</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.IzinDuzenle" Href="izinler">İzin Listesi</YetkiliBaglanti>
                <span class="yakinda">Kazanç-Kesinti Listesi</span>
                <span class="yakinda">Performans Listesi</span>
                <hr />
                <span class="yakinda">Yıllık İzin Raporu</span>
                <YetkiliBaglanti Yetki="@Yetkiler.UcretGor" Href="raporlar/maas-pusulasi">Kişisel Bordro (Excel, Pdf)</YetkiliBaglanti>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Araçlar ▾</span>
            <div class="menu-alt">
                <YetkiliBaglanti Yetki="@Yetkiler.Yedek" Href="araclar/yedek" Target="_blank">Data Yedekle (indir)</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.PuantajGor" Href="puantaj/toplu">Excel Dosyaya Puantaj Aktarımı</YetkiliBaglanti>
                <YetkiliBaglanti Yetki="@Yetkiler.VeriAktarim" Href="araclar/excel-aktarim">Excel Dosyadan Veri Al (personel, ücret, izin, kazanç-kesinti, hareket, bordro)</YetkiliBaglanti>
                <span class="yakinda">Geç / Mesai Kalanlar Onay</span>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Yardım ▾</span>
            <div class="menu-alt">
                <a href="hakkinda">Hakkında</a>
            </div>
        </div>
        <div class="ms-auto d-flex align-items-center gap-2">
            <AuthorizeView>
                <span class="small text-white-50">@context.User.Identity?.Name</span>
                <a class="btn btn-sm btn-outline-light" href="hesap/sifre">Şifre</a>
                <form method="post" action="hesap/cikis">
                    <AntiforgeryToken />
                    <button class="btn btn-sm btn-outline-light" type="submit">Çıkış</button>
                </form>
            </AuthorizeView>
        </div>
    </nav>
    <main class="sayfa flex-grow-1">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    Beklenmeyen bir hata oluştu.
    <a href="" class="reload">Yenile</a>
    <a class="dismiss">🗙</a>
</div>
