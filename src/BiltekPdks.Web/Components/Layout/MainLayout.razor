                <hr />
                <a href="personeller">Personel Listesi</a>
                <a href="hareketler">Giriş-Çıkış Listesi</a>
                <a href="izinler">İzin Listesi</a>
                <span class="yakinda">Kazanç-Kesinti Listesi</span>
                <span class="yakinda">Performans Listesi</span>
                <hr />
                <span class="yakinda">Yıllık İzin Raporu</span>
                <span class="yakinda">Kişisel Bordro (Excel, Pdf)</span>
            </div>
        </div>
        <div class="menu-grubu">
            <span class="menu-ogesi">Araçlar ▾</span>
            <div class="menu-alt">
                <a href="araclar/yedek" target="_blank">Data Yedekle (indir)</a>
                <a href="puantaj/toplu">Excel Dosyaya Puantaj Aktarımı</a>
