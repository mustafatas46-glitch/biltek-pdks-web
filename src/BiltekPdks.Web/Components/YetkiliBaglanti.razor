@* Menüde yalnızca yetkisi olan kullanıcıya görünen bağlantı. *@
<AuthorizeView Policy="@Yetki" Context="yetkiDurumu">
    <Authorized><a href="@Href" target="@Target">@ChildContent</a></Authorized>
</AuthorizeView>

@code {
    [Parameter, EditorRequired] public string Yetki { get; set; } = "";
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public string? Target { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
