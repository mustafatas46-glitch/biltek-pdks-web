@code {
    // Tarayıcı önbelleğinde eski stil dosyası kalmasın diye her derlemede değişen sürüm eki.
    private static readonly string Surum = System.IO.File.GetLastWriteTimeUtc(typeof(App).Assembly.Location).Ticks.ToString("x");
}
