@page "/grup-tanimlama"
@using BiltekPdks.Domain.Puantaj
@inject FirmaDb FirmaDb

<PageTitle>Grup Tanımlama</PageTitle>
<div class="d-flex align-items-end gap-3 mb-2 flex-wrap">
    <h1 class="h5 m-0">Hesap Parametreleri (Grup, Dönem, Resmi Tatil, Çalışma Planı)</h1>
    <div class="d-flex align-items-center gap-2 ms-auto">
        <span class="small fw-semibold">Yıl</span>
        <input class="form-control form-control-sm" type="number" style="width:6rem" @bind="_yil" @bind:after="YilDegistiAsync" />
        <a class="btn btn-sm btn-outline-secondary" href="vardiyalar">Günlük Çalışma Saatleri</a>
    </div>
</div>

@if (_mesaj is not null) { <div class="alert @(_hata ? "alert-danger" : "alert-success") py-1 small">@_mesaj</div> }

<div class="grup-ekrani">
    @* ---------- SOL: GRUPLAR + ALT GRUPLAR ---------- *@
    <div class="d-flex flex-column gap-2">
    <section class="border rounded bg-white">
        <div class="kirmizi-baslik">GRUP TANIMLARI</div>
        <div class="izgara" style="max-height:16rem">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Grup Adı</th><th>Günlük</th><th>Dönem Saat</th><th>Dönem Tipi</th></tr></thead>
                <tbody>
                    @foreach (var g in _gruplar)
                    {
                        <tr class="@(g.Id == _secili?.Id ? "secili" : "") @(g.Aktif ? "" : "text-muted")" @onclick="() => SecAsync(g.Id)"
                            @oncontextmenu="async e => { await SecAsync(g.Id); _menu.Ac(e, GrupMenusu()); }" @oncontextmenu:preventDefault="true">
                            <td>@g.Ad</td><td>@S(g.GunlukCalismaDakika)</td><td>@S(g.DonemlikCalismaDakika)</td><td>30 gün</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_duzen is not null)
        {
            <div class="p-2 border-top bg-light small">
                <div class="row g-2 align-items-center">
                    <label class="col-5 fw-semibold">Grup adı</label><div class="col-7"><input class="form-control form-control-sm" @bind="_duzen.Ad" /></div>
                    <label class="col-5 fw-semibold">Günlük çalışma</label><div class="col-7"><SureKutusu @bind-Dakika="_duzen.GunlukCalismaDakika" /></div>
                    <label class="col-5 fw-semibold">Dönem saati (ay)</label><div class="col-7"><SureKutusu @bind-Dakika="_duzen.DonemlikCalismaDakika" /></div>
                    <label class="col-5 fw-semibold">Maaş böleni (saat)</label><div class="col-7"><input class="form-control form-control-sm" type="number" @bind="_duzen.MaasBoleniSaat" /></div>
                    <label class="col-5 fw-semibold">Fazla mesai çarpanı</label><div class="col-7"><input class="form-control form-control-sm" type="number" step="0.05" @bind="_duzen.FazlaMesaiCarpani" /></div>
                    <label class="col-5 fw-semibold">Tatil mesaisi çarpanı</label><div class="col-7"><input class="form-control form-control-sm" type="number" step="0.05" @bind="_duzen.TatilMesaisiCarpani" /></div>
                    <div class="col-12"><label class="form-check m-0"><input class="form-check-input" type="checkbox" @bind="_duzen.Aktif" /> Aktif</label></div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-sm btn-primary" @onclick="GrupKaydetAsync">Kaydet</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _duzen = null">Vazgeç</button>
                </div>
            </div>
        }
        else
        {
            <div class="alt-cubuk">
                <button class="btn btn-sm btn-outline-success" @onclick="YeniGrup">Yeni grup</button>
                <button class="btn btn-sm btn-outline-primary" disabled="@(_secili is null)" @onclick="GrupDuzenle">Düzenle</button>
                <span class="small text-muted ms-auto">Sağ tık: işlemler</span>
            </div>
        }
    </section>

    <section class="border rounded bg-white">
        <div class="kirmizi-baslik">ALT GRUP TANIMLARI @(_secili is null ? "" : $"({_secili.Ad})")</div>
        <div class="izgara" style="max-height:12rem">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Alt Grup Adı</th><th>Günlük</th><th>Plan</th></tr></thead>
                <tbody>
                    @foreach (var a in _altGruplar)
                    {
                        var alt = a;
                        <tr class="@(alt.Id == _seciliAlt ? "secili" : "")" @onclick="() => AltSecAsync(alt.Id)"
                            @ondblclick="() => AltDuzenle(alt)"
                            @oncontextmenu="async e => { await AltSecAsync(alt.Id); _menu.Ac(e, AltGrupMenusu()); }" @oncontextmenu:preventDefault="true">
                            <td>@alt.Ad</td><td>@S(alt.GunlukCalismaDakika)</td><td class="small">@(_altPlanOzeti.GetValueOrDefault(alt.Id) ?? "—")</td>
                        </tr>
                    }
                    @if (_secili is not null && _altGruplar.Count == 0)
                    {
                        <tr @oncontextmenu="e => _menu.Ac(e, AltGrupMenusu())" @oncontextmenu:preventDefault="true">
                            <td colspan="3" class="text-muted small">Alt grup yok. Vardiyalı çalışılıyorsa (08-16, 16-24, 24-08) ekleyin.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_altDuzen is not null)
        {
            <div class="p-2 border-top bg-light small">
                <div class="row g-2 align-items-center">
                    <label class="col-5 fw-semibold">Alt grup adı</label><div class="col-7"><input class="form-control form-control-sm" placeholder="ör. 08-16" @bind="_altDuzen.Ad" /></div>
                    <label class="col-5 fw-semibold">Günlük çalışma</label><div class="col-7"><SureKutusu @bind-Dakika="_altDuzen.GunlukCalismaDakika" /></div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-sm btn-primary" @onclick="AltKaydetAsync">Kaydet</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _altDuzen = null">Vazgeç</button>
                </div>
            </div>
        }
        else
        {
            <div class="alt-cubuk">
                <button class="btn btn-sm btn-outline-success" disabled="@(_secili is null)" @onclick="YeniAlt">Yeni alt grup</button>
                <button class="btn btn-sm btn-outline-primary" disabled="@(_seciliAlt is null)" @onclick="() => AltDuzenle(_altGruplar.FirstOrDefault(x => x.Id == _seciliAlt))">Düzenle</button>
                <button class="btn btn-sm btn-outline-danger" disabled="@(_seciliAlt is null)" @onclick="AltSilAsync">Sil</button>
            </div>
        }
    </section>
    </div>

    @* ---------- SAĞ: SEKMELER ---------- *@
    <section class="border rounded bg-white">
        <ul class="nav nav-tabs small px-1 pt-1">
            @foreach (var (kod, ad) in Sekmeler)
            {
                <li class="nav-item"><a class="nav-link @(_sekme == kod ? "active" : "")" href="" @onclick:preventDefault @onclick="() => _sekme = kod">@ad</a></li>
            }
        </ul>
        <div class="p-3">
        @if (_secili is null)
        {
            <p class="text-muted">Soldan bir grup seçin.</p>
        }
        else if (_sekme == "plan")
        {
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <div class="kirmizi-baslik p-0">ÇALIŞMA PLANI</div>
                <select class="form-select form-select-sm" style="max-width:20rem" value="@(_planHedef?.ToString() ?? "")" @onchange="PlanHedefDegistiAsync">
                    <option value="">@_secili.Ad — grubun kendi planı</option>
                    @foreach (var a in _altGruplar) { <option value="@a.Id">@_secili.Ad / @a.Ad</option> }
                </select>
            </div>
            <div class="d-flex gap-4 flex-wrap">
                <table class="table table-sm align-middle mb-0" style="max-width:520px">
                    <tbody>
                        @foreach (var gun in Gunler)
                        {
                            <tr>
                                <th style="width:8rem">@CalismaPlani.GunAdi(gun)</th>
                                <td><TanimSecici @bind-Value="_plan[gun]" Secenekler="_vardiyalar" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-sm btn-outline-secondary" title="Pazartesi planını Salı–Cuma günlerine kopyalar" @onclick="PazartesidenKopyala">Pazartesi'den kopyala</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="KutulariTemizle">Kutuları temizle</button>
                    <button class="btn btn-sm btn-primary mt-3" @onclick="PlanKaydetAsync">Kaydet</button>
                </div>
            </div>
            <p class="small text-muted mt-2 mb-0">Boş bırakılan gün hafta tatilidir. Günlere atanan planlar <a href="vardiyalar">Günlük Çalışma Saatleri</a> ekranında tanımlanır.
                @if (_altGruplar.Count > 0)
                {
                    <br />@("Alt grubu sicil kartında sabitlenmeyen personelde, puantaj o günün okutmasına en uygun alt grubu kendisi seçer.")
                }
            </p>
        }
        else if (_sekme == "donem")
        {
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <div class="kirmizi-baslik p-0">DÖNEM TANIMLARI (@_secili.Ad, @_yil, 30 gün hesabı)</div>
                <button class="btn btn-sm btn-outline-success ms-auto" @onclick="DonemEkle">Dönem ekle</button>
                @if (_donemler.Count == 0) { <button class="btn btn-sm btn-outline-primary" @onclick="YilinDonemleriniOlusturAsync">@_yil yılının dönemlerini oluştur</button> }
            </div>
            <table class="table table-sm table-bordered table-hover small mb-1" style="max-width:980px">
                <thead><tr><th>Baş. Tarih</th><th>Bit. Tarih</th><th>Alt Grup</th><th>Giriş</th><th>Çıkış</th><th>Gün Farkı</th><th>Eksik Gün</th><th>Eksik Saat</th><th>Fazla Gün</th><th>Fazla Saat</th><th title="Seçili çalışma planına göre dönemin planlanan çalışma süresi">Plana göre çalışma</th></tr></thead>
                <tbody>
                    @if (_donemler.Count > 0)
                    {
                        foreach (var d in _donemler)
                        {
                            var donem = d;
                            <tr class="@(donem.Id == _seciliDonem ? "table-primary" : "")" style="cursor:pointer" @onclick="() => _seciliDonem = donem.Id" @ondblclick="() => DonemDegistir(donem)"
                                @oncontextmenu="e => { _seciliDonem = donem.Id; _menu.Ac(e, DonemMenusu(donem)); }" @oncontextmenu:preventDefault="true">
                                <td>@donem.Baslangic.ToString("dd MMM yyyy", Tr)</td><td>@donem.Bitis.ToString("dd MMM yyyy", Tr)</td>
                                <td>@(donem.AltGrupId is int ag ? _altGruplar.FirstOrDefault(x => x.Id == ag)?.Ad : "")</td>
                                <td>@(donem.GirisSaati?.ToString("HH:mm"))</td><td>@(donem.CikisSaati?.ToString("HH:mm"))</td>
                                <td class="text-end">@donem.GunFarki</td>
                                <td class="text-end">@Sifirsiz(donem.EksikGun)</td><td class="text-end">@S(donem.EksikDakika)</td>
                                <td class="text-end">@Sifirsiz(donem.FazlaGun)</td><td class="text-end">@S(donem.FazlaDakika)</td>
                                <td class="text-end">@S(PlanDakika(donem.Baslangic, donem.Bitis))</td>
                            </tr>
                        }
                    }
                    else
                    {
                        foreach (var d in Donemler())
                        {
                            <tr class="text-muted" @oncontextmenu="e => _menu.Ac(e, DonemMenusu(null))" @oncontextmenu:preventDefault="true">
                                <td>@d.Bas.ToString("dd MMM yyyy", Tr)</td><td>@d.Bit.ToString("dd MMM yyyy", Tr)</td><td></td><td></td><td></td><td class="text-end">@d.Gun</td>
                                <td class="text-end">@(d.Gun < 30 ? (30 - d.Gun).ToString() : "")</td><td class="text-end">@(d.Gun < 30 ? S((30 - d.Gun) * _secili.GunlukCalismaDakika) : "")</td>
                                <td class="text-end">@(d.Gun > 30 ? (d.Gun - 30).ToString() : "")</td><td class="text-end">@(d.Gun > 30 ? S((d.Gun - 30) * _secili.GunlukCalismaDakika) : "")</td>
                                <td class="text-end">@S(d.PlanDakika)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <p class="small text-muted mb-0">
                @(_donemler.Count == 0 ? "Kayıtlı dönem yok; takvim ayları gösteriliyor. " : "Çift tık ya da sağ tık: dönemi değiştir / sil. ")
                Her dönem 30 gün sayılır: 31 çeken dönemde 1 gün fazla, şubatta 2 (artık yılda 1) gün eksik olur. Saat karşılığı günlük çalışma süresiyle hesaplanır.
            </p>
        }
        else if (_sekme == "tatil")
        {
            <div class="kirmizi-baslik mb-2">RESMİ TATİL TANIMLARI (@_yil)</div>
            <div class="d-flex gap-3 flex-wrap">
                <div class="izgara border" style="max-height:24rem; min-width:420px">
                    <table class="table table-sm table-hover mb-0 small">
                        <thead><tr><th>Tarih</th><th>Gün</th><th>Tatil Adı</th></tr></thead>
                        <tbody>
                            @foreach (var t in _tatiller)
                            {
                                <tr class="@(t.Id == _seciliTatil ? "secili" : "")" @onclick="() => _seciliTatil = t.Id"
                                    @oncontextmenu="e => { _seciliTatil = t.Id; _menu.Ac(e, TatilMenusu()); }" @oncontextmenu:preventDefault="true">
                                    <td>@t.Tarih.ToString("dd MMM yyyy", Tr)</td><td>@CalismaPlani.GunAdi(t.Tarih.DayOfWeek)</td><td>@t.Ad</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_tatiller.Count == 0) { <p class="text-muted small p-2 mb-0">Bu yıl için tatil yok.</p> }
                </div>
                <div style="width:280px">
                    <div class="border rounded p-2 small">
                        <div class="fw-semibold mb-1">Resmi tatil ekle</div>
                        <label class="form-label mb-0">Baş. tarih</label><input class="form-control form-control-sm mb-1" type="date" @bind="_tatilBas" />
                        <label class="form-label mb-0">Bit. tarih</label><input class="form-control form-control-sm mb-1" type="date" @bind="_tatilBit" />
                        <label class="form-label mb-0">Tatil adı</label><input class="form-control form-control-sm mb-2" @bind="_tatilAd" />
                        <button class="btn btn-sm btn-success" @onclick="TatilEkleAsync">Ekle</button>
                        <button class="btn btn-sm btn-outline-danger" disabled="@(_seciliTatil is null)" @onclick="TatilSilAsync">Seçiliyi sil</button>
                    </div>
                    <button class="btn btn-sm btn-outline-primary mt-2 w-100" @onclick="YilinTatilleriniOlusturAsync">@_yil yılının resmi tatillerini oluştur</button>
                    @if (!ResmiTatilTakvimi.DiniBayramlarBiliniyor(_yil))
                    {
                        <p class="small text-muted mt-1 mb-0">@_yil için Ramazan ve Kurban bayramı tarihlerini elle ekleyin.</p>
                    }
                </div>
            </div>
            <p class="small text-muted mt-2 mb-0">Resmi tatiller tüm gruplar için geçerlidir. O gün çalışılan süre %100 (tatil mesaisi) yazılır.</p>
        }
        else
        {
            <div class="kirmizi-baslik mb-2">ÜCRET HESABI KURALLARI (@_secili.Ad)</div>
            <dl class="row small" style="max-width:620px">
                <dt class="col-6">Saat ücreti</dt><dd class="col-6">maaş / @_secili.MaasBoleniSaat</dd>
                <dt class="col-6">Fazla mesai (%50)</dt><dd class="col-6">saat ücreti × @_secili.FazlaMesaiCarpani</dd>
                <dt class="col-6">Tatil mesaisi (%100)</dt><dd class="col-6">saat ücreti × @_secili.TatilMesaisiCarpani</dd>
                <dt class="col-6">Ay gün sayısı</dt><dd class="col-6">her ay 30 gün</dd>
            </dl>
            <p class="small text-muted">Değiştirmek için soldaki grubu seçip "Düzenle"ye basın.</p>
        }
        </div>
    </section>
</div>

@if (_donemPencere is not null && _secili is not null)
{
    <div class="pdks-pencere-arka" @onclick="() => _donemPencere = null"></div>
    <div class="pdks-pencere" role="dialog" aria-label="Dönem ekle / değiştir" style="width:min(520px, calc(100vw - 2rem))">
        <div class="fw-semibold mb-2">@(_donemPencere.Id == 0 ? "Dönem Ekle" : "Dönem Değiştir") — @_secili.Ad</div>
        <div class="row g-2 small align-items-center">
            <label class="col-4">Baş. tarih</label><div class="col-8"><input class="form-control form-control-sm" type="date" @bind="_donemPencere.Baslangic" /></div>
            <label class="col-4">Bit. tarih</label><div class="col-8"><input class="form-control form-control-sm" type="date" @bind="_donemPencere.Bitis" /></div>
            @if (_altGruplar.Count > 0)
            {
                <label class="col-4">Alt grup</label>
                <div class="col-8"><TanimSecici @bind-Value="_donemPencere.AltGrupId" Secenekler="@(_altGruplar.Select(x => new TanimSecenek(x.Id, x.Ad)).ToList())" /></div>
            }
            <label class="col-4">Giriş saati</label><div class="col-8"><input class="form-control form-control-sm" type="time" @bind="_donemPencere.GirisSaati" /></div>
            <label class="col-4">Çıkış saati</label><div class="col-8"><input class="form-control form-control-sm" type="time" @bind="_donemPencere.CikisSaati" /></div>
            <div class="col-12"><button class="btn btn-sm btn-outline-primary" @onclick="GunHesapla">Gün hesapla</button></div>
            <label class="col-4">Gün farkı</label><div class="col-8"><input class="form-control form-control-sm" type="number" @bind="_donemPencere.GunFarki" /></div>
            <label class="col-4">Eksik gün</label><div class="col-3"><input class="form-control form-control-sm" type="number" min="0" @bind="_donemPencere.EksikGun" /></div>
            <label class="col-2">saat</label><div class="col-3"><SureKutusu @bind-Dakika="_donemPencere.EksikDakika" /></div>
            <label class="col-4">Fazla gün</label><div class="col-3"><input class="form-control form-control-sm" type="number" min="0" @bind="_donemPencere.FazlaGun" /></div>
            <label class="col-2">saat</label><div class="col-3"><SureKutusu @bind-Dakika="_donemPencere.FazlaDakika" /></div>
        </div>
        @if (_donemHata is not null) { <div class="alert alert-danger py-1 small mt-2 mb-0">@_donemHata</div> }
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-primary" @onclick="DonemKaydetAsync">Kaydet</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _donemPencere = null">Vazgeç</button>
        </div>
    </div>
}

<SagTikMenu @ref="_menu" />

@code {
    private static readonly System.Globalization.CultureInfo Tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    private static readonly (string Kod, string Ad)[] Sekmeler = { ("plan", "Çalışma Planı"), ("donem", "Dönem"), ("tatil", "Resmi Tatil"), ("diger", "Diğer") };
    private static readonly DayOfWeek[] Gunler =
        { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };

    private sealed record DonemSatiri(DateOnly Bas, DateOnly Bit, int Gun, int PlanDakika);

    private SagTikMenu _menu = default!;
    private List<CalismaGrubu> _gruplar = new();
    private CalismaGrubu? _secili;
    private CalismaGrubu? _duzen;
    private List<TanimSecenek> _vardiyalar = new();
    private Dictionary<int, int> _vardiyaDakika = new();
    private Dictionary<DayOfWeek, int?> _plan = Gunler.ToDictionary(g => g, _ => (int?)null);
    private List<ResmiTatil> _tatiller = new();
    private int? _seciliTatil;
    private DateOnly? _tatilBas, _tatilBit;
    private string? _tatilAd, _mesaj;
    private bool _hata;
    private string _sekme = "plan";
    private List<AltGrup> _altGruplar = new();
    private Dictionary<int, string> _altPlanOzeti = new();
    private int? _seciliAlt;
    private AltGrup? _altDuzen;
    private int? _planHedef;
    private List<DonemTanimi> _donemler = new();
    private int? _seciliDonem;
    private DonemTanimi? _donemPencere;
    private string? _donemHata;
    private int _yil = DateTime.Today.Year;

    private static string S(int dk) => dk == 0 ? "" : $"{dk / 60}:{dk % 60:00}";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await FirmaDb.AcAsync();
        var vardiyalar = await db.Vardiyalar.AsNoTracking().Include(v => v.Molalar).Where(v => v.Aktif).OrderBy(v => v.Ad).ToListAsync();
        _vardiyalar = vardiyalar.Select(v => new TanimSecenek(v.Id, v.Ad)).ToList();
        _vardiyaDakika = vardiyalar.ToDictionary(v => v.Id, v => v.Kural().PlanlananDakika(new DateOnly(2000, 1, 3)));
        await GruplariYukleAsync();
        if (_gruplar.Count > 0) await SecAsync(_gruplar[0].Id);
        await TatilleriYukleAsync();
    }

    private async Task GruplariYukleAsync()
    {
        await using var db = await FirmaDb.AcAsync();
        _gruplar = await db.CalismaGruplari.AsNoTracking().OrderByDescending(g => g.Aktif).ThenBy(g => g.Ad).ToListAsync();
    }

    private async Task SecAsync(int id)
    {
        if (_secili?.Id != id) { _planHedef = null; _seciliAlt = null; _altDuzen = null; _seciliDonem = null; }
        _secili = _gruplar.FirstOrDefault(g => g.Id == id);
        _duzen = null;
        await AltGruplariYukleAsync();
        await PlanYukleAsync();
        await DonemleriYukleAsync();
    }

    private async Task PlanYukleAsync()
    {
        if (_secili is null) return;
        await using var db = await FirmaDb.AcAsync();
        if (_planHedef is int aid)
        {
            var kayitlar = await db.AltGrupGunleri.AsNoTracking().Where(x => x.AltGrupId == aid).ToListAsync();
            _plan = Gunler.ToDictionary(g => g, g => kayitlar.FirstOrDefault(k => k.Gun == g)?.VardiyaId);
        }
        else
        {
            var kayitlar = await db.CalismaGrubuGunleri.AsNoTracking().Where(x => x.CalismaGrubuId == _secili.Id).ToListAsync();
            _plan = Gunler.ToDictionary(g => g, g => kayitlar.FirstOrDefault(k => k.Gun == g)?.VardiyaId);
        }
    }

    private async Task PlanHedefDegistiAsync(ChangeEventArgs e)
    {
        _planHedef = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        if (_planHedef is int a) _seciliAlt = a;
        await PlanYukleAsync();
    }

    private async Task YilDegistiAsync()
    {
        await TatilleriYukleAsync();
        await DonemleriYukleAsync();
    }

    // ---- Alt gruplar ----

    private async Task AltGruplariYukleAsync()
    {
        if (_secili is null) { _altGruplar = new(); return; }
        await using var db = await FirmaDb.AcAsync();
        _altGruplar = await db.AltGruplar.AsNoTracking().Where(x => x.CalismaGrubuId == _secili.Id).OrderBy(x => x.Ad).ToListAsync();
        var idler = _altGruplar.Select(x => x.Id).ToList();
        var gunler = await db.AltGrupGunleri.AsNoTracking().Where(x => idler.Contains(x.AltGrupId) && x.VardiyaId != null).ToListAsync();
        var adlar = _vardiyalar.ToDictionary(v => v.Id, v => v.Ad);
        _altPlanOzeti = gunler.GroupBy(x => x.AltGrupId).ToDictionary(g => g.Key,
            g => string.Join(", ", g.Select(x => adlar.GetValueOrDefault(x.VardiyaId!.Value) ?? "?").Distinct()));
    }

    private async Task AltSecAsync(int id)
    {
        _seciliAlt = id;
        _planHedef = id;
        await PlanYukleAsync();
    }

    private void YeniAlt()
    {
        if (_secili is null) return;
        _altDuzen = new AltGrup { CalismaGrubuId = _secili.Id, GunlukCalismaDakika = _secili.GunlukCalismaDakika, Aktif = true };
    }

    private void AltDuzenle(AltGrup? a)
    {
        if (a is null) return;
        _altDuzen = new AltGrup { Id = a.Id, CalismaGrubuId = a.CalismaGrubuId, Ad = a.Ad, GunlukCalismaDakika = a.GunlukCalismaDakika, Aktif = a.Aktif };
    }

    private async Task AltKaydetAsync()
    {
        if (_altDuzen is null || _secili is null) return;
        var ad = _altDuzen.Ad?.Trim() ?? "";
        if (ad.Length == 0) { Bildir("Alt grup adı boş olamaz.", true); return; }
        if (_altGruplar.Any(x => x.Id != _altDuzen.Id && string.Equals(x.Ad, ad, StringComparison.CurrentCultureIgnoreCase)))
        { Bildir("Bu grupta aynı adlı alt grup var.", true); return; }
        await using var db = await FirmaDb.AcAsync();
        AltGrup a;
        if (_altDuzen.Id == 0) { a = new AltGrup { CalismaGrubuId = _secili.Id }; db.AltGruplar.Add(a); }
        else a = await db.AltGruplar.FirstAsync(x => x.Id == _altDuzen.Id);
        a.Ad = ad.Length > 120 ? ad[..120] : ad;
        a.GunlukCalismaDakika = _altDuzen.GunlukCalismaDakika;
        await db.SaveChangesAsync();
        var yeni = _altDuzen.Id == 0;
        _altDuzen = null;
        await AltGruplariYukleAsync();
        if (yeni)
        {
            // Yeni alt grubun planı boş başlar; hemen planını girmek için seçilir.
            await AltSecAsync(a.Id);
            _sekme = "plan";
        }
        Bildir(yeni ? $"\"{a.Ad}\" alt grubu eklendi. Çalışma planını girip kaydedin." : "Alt grup kaydedildi.");
    }

    private async Task AltSilAsync()
    {
        if (_seciliAlt is not int id) return;
        await using var db = await FirmaDb.AcAsync();
        var kisi = await db.Personeller.CountAsync(p => p.AltGrupId == id);
        if (kisi > 0) { Bildir($"Bu alt grupta sabitlenmiş {kisi} personel var; önce sicil kartlarından alt grubu kaldırın.", true); return; }
        await db.AltGruplar.Where(x => x.Id == id).ExecuteDeleteAsync();
        _seciliAlt = null;
        if (_planHedef == id) _planHedef = null;
        await AltGruplariYukleAsync();
        await PlanYukleAsync();
        await DonemleriYukleAsync();
        Bildir("Alt grup silindi.");
    }

    private List<SagTikMenu.Oge> AltGrupMenusu() => new()
    {
        SagTikMenu.Oge.Eylemli("Yeni alt grup", YeniAlt, pasif: _secili is null),
        SagTikMenu.Oge.Eylemli("Alt grubu düzenle", () => AltDuzenle(_altGruplar.FirstOrDefault(x => x.Id == _seciliAlt)), pasif: _seciliAlt is null),
        new("Alt grubu sil", AltSilAsync, Pasif: _seciliAlt is null),
        SagTikMenu.Oge.Cizgi(),
        SagTikMenu.Oge.Eylemli("Çalışma planını göster", () => _sekme = "plan", pasif: _seciliAlt is null),
        SagTikMenu.Oge.Eylemli("Dönemler", () => _sekme = "donem"),
    };

    // ---- Dönemler ----

    private async Task DonemleriYukleAsync()
    {
        if (_secili is null || _yil is < 2000 or > 2100) { _donemler = new(); return; }
        var bas = new DateOnly(_yil, 1, 1);
        var bit = new DateOnly(_yil, 12, 31);
        await using var db = await FirmaDb.AcAsync();
        _donemler = await db.DonemTanimlari.AsNoTracking()
            .Where(d => d.CalismaGrubuId == _secili.Id && d.Bitis >= bas && d.Baslangic <= bit)
            .OrderBy(d => d.Baslangic).ThenBy(d => d.AltGrupId).ToListAsync();
    }

    private void DonemEkle()
    {
        if (_secili is null) return;
        // Son dönemin ertesi gününden başlayan bir aylık dönem önerilir.
        var bas = _donemler.Count > 0 ? _donemler.Max(d => d.Bitis).AddDays(1) : new DateOnly(_yil, 1, 1);
        _donemPencere = new DonemTanimi { CalismaGrubuId = _secili.Id, Baslangic = bas, Bitis = bas.AddMonths(1).AddDays(-1), AltGrupId = _planHedef };
        GunHesapla();
        _donemHata = null;
    }

    private void DonemDegistir(DonemTanimi d)
    {
        _donemPencere = new DonemTanimi
        {
            Id = d.Id, CalismaGrubuId = d.CalismaGrubuId, AltGrupId = d.AltGrupId, Baslangic = d.Baslangic, Bitis = d.Bitis,
            GirisSaati = d.GirisSaati, CikisSaati = d.CikisSaati, GunFarki = d.GunFarki, EksikGun = d.EksikGun, EksikDakika = d.EksikDakika,
            FazlaGun = d.FazlaGun, FazlaDakika = d.FazlaDakika,
        };
        _donemHata = null;
    }

    private int GunlukDakika(int? altGrupId) =>
        altGrupId is int a && _altGruplar.FirstOrDefault(x => x.Id == a) is { } alt ? alt.GunlukCalismaDakika : _secili?.GunlukCalismaDakika ?? 450;

    private void GunHesapla()
    {
        if (_donemPencere is null) return;
        if (_donemPencere.Bitis < _donemPencere.Baslangic) { _donemHata = "Bitiş tarihi başlangıçtan önce olamaz."; return; }
        _donemPencere.GunHesapla(GunlukDakika(_donemPencere.AltGrupId));
        _donemHata = null;
    }

    private async Task DonemKaydetAsync()
    {
        var d = _donemPencere;
        if (d is null || _secili is null) return;
        if (d.Bitis < d.Baslangic) { _donemHata = "Bitiş tarihi başlangıçtan önce olamaz."; return; }
        if (d.Bitis.DayNumber - d.Baslangic.DayNumber > 62) { _donemHata = "Bir dönem en çok iki ay olabilir."; return; }
        if (d.GunFarki == 0) d.GunHesapla(GunlukDakika(d.AltGrupId));
        await using var db = await FirmaDb.AcAsync();
        var cakisan = await db.DonemTanimlari.AnyAsync(x => x.Id != d.Id && x.CalismaGrubuId == _secili.Id && x.AltGrupId == d.AltGrupId
            && x.Baslangic <= d.Bitis && x.Bitis >= d.Baslangic);
        if (cakisan) { _donemHata = "Bu tarihlerle çakışan başka bir dönem var."; return; }

        DonemTanimi k;
        if (d.Id == 0) { k = new DonemTanimi { CalismaGrubuId = _secili.Id }; db.DonemTanimlari.Add(k); }
        else k = await db.DonemTanimlari.FirstAsync(x => x.Id == d.Id);
        k.AltGrupId = d.AltGrupId;
        k.Baslangic = d.Baslangic; k.Bitis = d.Bitis; k.GirisSaati = d.GirisSaati; k.CikisSaati = d.CikisSaati;
        k.GunFarki = d.GunFarki; k.EksikGun = Math.Max(0, d.EksikGun); k.EksikDakika = Math.Max(0, d.EksikDakika);
        k.FazlaGun = Math.Max(0, d.FazlaGun); k.FazlaDakika = Math.Max(0, d.FazlaDakika);
        await db.SaveChangesAsync();
        _donemPencere = null;
        _yil = k.Baslangic.Year;
        await DonemleriYukleAsync();
        _seciliDonem = k.Id;
        Bildir("Dönem kaydedildi.");
    }

    private async Task DonemSilAsync(int id)
    {
        await using var db = await FirmaDb.AcAsync();
        await db.DonemTanimlari.Where(x => x.Id == id).ExecuteDeleteAsync();
        _seciliDonem = null;
        await DonemleriYukleAsync();
        Bildir("Dönem silindi.");
    }

    private async Task YilinDonemleriniOlusturAsync()
    {
        if (_secili is null) return;
        await using var db = await FirmaDb.AcAsync();
        for (var ay = 1; ay <= 12; ay++)
        {
            var bas = new DateOnly(_yil, ay, 1);
            var d = new DonemTanimi { CalismaGrubuId = _secili.Id, Baslangic = bas, Bitis = bas.AddMonths(1).AddDays(-1) };
            d.GunHesapla(_secili.GunlukCalismaDakika);
            db.DonemTanimlari.Add(d);
        }
        await db.SaveChangesAsync();
        await DonemleriYukleAsync();
        Bildir($"{_yil} yılının 12 dönemi oluşturuldu.");
    }

    private List<SagTikMenu.Oge> DonemMenusu(DonemTanimi? d) => new()
    {
        SagTikMenu.Oge.Eylemli("Dönem ekle", DonemEkle),
        SagTikMenu.Oge.Eylemli("Dönem değiştir", () => { if (d is not null) DonemDegistir(d); }, pasif: d is null),
        new("Dönem sil", () => d is null ? Task.CompletedTask : DonemSilAsync(d.Id), Pasif: d is null),
        SagTikMenu.Oge.Cizgi(),
        new($"{_yil} yılının dönemlerini oluştur", YilinDonemleriniOlusturAsync, Pasif: _donemler.Count > 0, PasifNedeni: "Bu yıl için dönem zaten var."),
    };

    private int PlanDakika(DateOnly bas, DateOnly bit)
    {
        var plan = 0;
        for (var t = bas; t <= bit; t = t.AddDays(1))
            if (_plan.TryGetValue(t.DayOfWeek, out var v) && v is int vid && _vardiyaDakika.TryGetValue(vid, out var dk)
                && !_tatiller.Any(x => x.Tarih == t))
                plan += dk;
        return plan;
    }

    private static string Sifirsiz(int n) => n == 0 ? "" : n.ToString();

    private List<SagTikMenu.Oge> GrupMenusu() => new()
    {
        SagTikMenu.Oge.Eylemli("Yeni grup", YeniGrup),
        SagTikMenu.Oge.Eylemli("Grubu düzenle", GrupDuzenle),
        SagTikMenu.Oge.Cizgi(),
        SagTikMenu.Oge.Eylemli("Çalışma planı", () => _sekme = "plan"),
        SagTikMenu.Oge.Eylemli("Dönemler", () => _sekme = "donem"),
        SagTikMenu.Oge.Eylemli("Resmi tatiller", () => _sekme = "tatil"),
        SagTikMenu.Oge.Eylemli("Yeni alt grup", YeniAlt),
        SagTikMenu.Oge.Cizgi(),
        new("Yenile", GruplariYukleAsync),
    };

    private List<SagTikMenu.Oge> TatilMenusu() => new()
    {
        new("Seçili tatili sil", TatilSilAsync),
        new($"{_yil} yılının resmi tatillerini oluştur", YilinTatilleriniOlusturAsync),
    };

    private void YeniGrup() => _duzen = new CalismaGrubu { Ad = "", Aktif = true, GunlukCalismaDakika = 450, DonemlikCalismaDakika = 13500 };

    private void GrupDuzenle()
    {
        if (_secili is null) return;
        _duzen = new CalismaGrubu
        {
            Id = _secili.Id, Ad = _secili.Ad, Kod = _secili.Kod, Aktif = _secili.Aktif,
            GunlukCalismaDakika = _secili.GunlukCalismaDakika, DonemlikCalismaDakika = _secili.DonemlikCalismaDakika,
            MaasBoleniSaat = _secili.MaasBoleniSaat, FazlaMesaiCarpani = _secili.FazlaMesaiCarpani, TatilMesaisiCarpani = _secili.TatilMesaisiCarpani,
        };
    }

    private async Task GrupKaydetAsync()
    {
        if (_duzen is null) return;
        if (string.IsNullOrWhiteSpace(_duzen.Ad)) { Bildir("Grup adı boş olamaz.", true); return; }
        if (_duzen.MaasBoleniSaat <= 0 || _duzen.FazlaMesaiCarpani <= 0 || _duzen.TatilMesaisiCarpani <= 0) { Bildir("Bölen ve çarpanlar sıfırdan büyük olmalı.", true); return; }
        await using var db = await FirmaDb.AcAsync();
        CalismaGrubu g;
        if (_duzen.Id == 0) { g = new CalismaGrubu(); db.CalismaGruplari.Add(g); }
        else g = await db.CalismaGruplari.FirstAsync(x => x.Id == _duzen.Id);
        g.Ad = _duzen.Ad.Trim();
        g.Aktif = _duzen.Aktif;
        g.GunlukCalismaDakika = _duzen.GunlukCalismaDakika;
        g.DonemlikCalismaDakika = _duzen.DonemlikCalismaDakika;
        g.MaasBoleniSaat = _duzen.MaasBoleniSaat;
        g.FazlaMesaiCarpani = _duzen.FazlaMesaiCarpani;
        g.TatilMesaisiCarpani = _duzen.TatilMesaisiCarpani;
        await db.SaveChangesAsync();
        await GruplariYukleAsync();
        await SecAsync(g.Id);
        Bildir("Grup kaydedildi.");
    }

    private void PazartesidenKopyala()
    {
        foreach (var g in Gunler.Where(g => g is not (DayOfWeek.Monday or DayOfWeek.Saturday or DayOfWeek.Sunday)))
            _plan[g] = _plan[DayOfWeek.Monday];
    }

    private void KutulariTemizle()
    {
        foreach (var g in Gunler) _plan[g] = null;
    }

    private async Task PlanKaydetAsync()
    {
        if (_secili is null) return;
        await using var db = await FirmaDb.AcAsync();
        if (_planHedef is int aid)
        {
            var altKayitlar = await db.AltGrupGunleri.Where(x => x.AltGrupId == aid).ToListAsync();
            foreach (var gun in Gunler)
            {
                var kayit = altKayitlar.FirstOrDefault(k => k.Gun == gun);
                if (kayit is null) { kayit = new AltGrupGunu { AltGrupId = aid, Gun = gun }; db.AltGrupGunleri.Add(kayit); }
                kayit.VardiyaId = _plan[gun];
            }
            await db.SaveChangesAsync();
            await AltGruplariYukleAsync();
            Bildir($"\"{_altGruplar.FirstOrDefault(x => x.Id == aid)?.Ad}\" alt grubunun çalışma planı kaydedildi.");
            return;
        }
        var kayitlar = await db.CalismaGrubuGunleri.Where(x => x.CalismaGrubuId == _secili.Id).ToListAsync();
        foreach (var gun in Gunler)
        {
            var kayit = kayitlar.FirstOrDefault(k => k.Gun == gun);
            if (kayit is null) { kayit = new CalismaGrubuGunu { CalismaGrubuId = _secili.Id, Gun = gun }; db.CalismaGrubuGunleri.Add(kayit); }
            kayit.VardiyaId = _plan[gun];
        }
        await db.SaveChangesAsync();
        Bildir("Çalışma planı kaydedildi.");
    }

    private IEnumerable<DonemSatiri> Donemler()
    {
        for (var ay = 1; ay <= 12; ay++)
        {
            var bas = new DateOnly(_yil, ay, 1);
            var bit = bas.AddMonths(1).AddDays(-1);
            var plan = 0;
            for (var t = bas; t <= bit; t = t.AddDays(1))
                if (_plan.TryGetValue(t.DayOfWeek, out var v) && v is int vid && _vardiyaDakika.TryGetValue(vid, out var dk)
                    && !_tatiller.Any(x => x.Tarih == t))
                    plan += dk;
            yield return new DonemSatiri(bas, bit, bit.Day, plan);
        }
    }

    private async Task TatilleriYukleAsync()
    {
        if (_yil is < 2000 or > 2100) return;
        await using var db = await FirmaDb.AcAsync();
        var bas = new DateOnly(_yil, 1, 1);
        var bit = new DateOnly(_yil, 12, 31);
        _tatiller = await db.ResmiTatiller.AsNoTracking().Where(t => t.Tarih >= bas && t.Tarih <= bit).OrderBy(t => t.Tarih).ToListAsync();
        _seciliTatil = null;
    }

    private async Task TatilEkleAsync()
    {
        if (_tatilBas is not DateOnly bas || string.IsNullOrWhiteSpace(_tatilAd)) { Bildir("Başlangıç tarihi ve tatil adı girin.", true); return; }
        var bit = _tatilBit ?? bas;
        if (bit < bas || bit.DayNumber - bas.DayNumber > 15) { Bildir("Tarih aralığı hatalı (en çok 15 gün).", true); return; }
        await using var db = await FirmaDb.AcAsync();
        var mevcut = await db.ResmiTatiller.Where(t => t.Tarih >= bas && t.Tarih <= bit).Select(t => t.Tarih).ToListAsync();
        var eklenen = 0;
        for (var t = bas; t <= bit; t = t.AddDays(1))
        {
            if (mevcut.Contains(t)) continue;
            db.ResmiTatiller.Add(new ResmiTatil { Tarih = t, Ad = _tatilAd.Trim() });
            eklenen++;
        }
        await db.SaveChangesAsync();
        _yil = bas.Year;
        _tatilBas = _tatilBit = null;
        _tatilAd = null;
        await TatilleriYukleAsync();
        Bildir($"{eklenen} gün eklendi.");
    }

    private async Task TatilSilAsync()
    {
        if (_seciliTatil is not int id) return;
        await using var db = await FirmaDb.AcAsync();
        var t = await db.ResmiTatiller.FirstOrDefaultAsync(x => x.Id == id);
        if (t is not null) { db.ResmiTatiller.Remove(t); await db.SaveChangesAsync(); }
        await TatilleriYukleAsync();
    }

    private async Task YilinTatilleriniOlusturAsync()
    {
        await using var db = await FirmaDb.AcAsync();
        var bas = new DateOnly(_yil, 1, 1);
        var bit = new DateOnly(_yil, 12, 31);
        var mevcut = await db.ResmiTatiller.Where(t => t.Tarih >= bas && t.Tarih <= bit).Select(t => t.Tarih).ToListAsync();
        var eklenen = 0;
        foreach (var t in ResmiTatilTakvimi.Yil(_yil).Where(t => !mevcut.Contains(t.Tarih)))
        {
            db.ResmiTatiller.Add(new ResmiTatil { Tarih = t.Tarih, Ad = t.Ad });
            eklenen++;
        }
        await db.SaveChangesAsync();
        await TatilleriYukleAsync();
        Bildir(eklenen == 0 ? "Bu yılın tatilleri zaten tanımlı." : $"{eklenen} resmi tatil eklendi.");
    }

    private void Bildir(string m, bool hata = false)
    {
        _mesaj = m;
        _hata = hata;
    }
}
