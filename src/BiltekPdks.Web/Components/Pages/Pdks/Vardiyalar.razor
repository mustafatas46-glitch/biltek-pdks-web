@page "/vardiyalar"
@using BiltekPdks.Domain.Puantaj
@inject FirmaDb FirmaDb

<PageTitle>Günlük Çalışma Saatleri</PageTitle>
<h1 class="h5 mb-1">Günlük Çalışma Saati (Puantaj Hesaplama) Parametreleri</h1>
<p class="text-muted small mb-2">Her satır bir günlük çalışma planıdır (HAFTAİÇİ, CUMARTESİ, PAZAR, VD1/VD2/VD3…); <a href="grup-tanimlama">Grup Tanımlama</a> ekranında günlere atanır.</p>

@if (_hata is not null) { <div class="alert alert-danger py-1 small">@_hata</div> }
@if (_bilgi is not null) { <div class="alert alert-success py-1 small">@_bilgi</div> }

<div class="grup-ekrani">
    <section class="border rounded bg-white">
        <div class="kirmizi-baslik">GÜNLÜK ÇALIŞMA SAATİ</div>
        <div class="izgara" style="max-height:calc(100vh - 18rem)">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>Plan adı</th><th>Saat</th><th>Günlük süre</th></tr></thead>
                <tbody>
                    @foreach (var v in _liste)
                    {
                        <tr class="@(v.Id == _secili?.Id ? "secili" : "") @(v.Aktif ? "" : "text-muted")" @onclick="() => Sec(v.Id)"
                            @oncontextmenu="e => { Sec(v.Id); _menu.Ac(e, Menu()); }" @oncontextmenu:preventDefault="true">
                            <td>@v.Ad</td><td>@v.Baslangic.ToString("HH:mm")-@v.Bitis.ToString("HH:mm")</td><td>@S(v.Kural().PlanlananDakika(Ornek))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="alt-cubuk">
            <button class="btn btn-sm btn-outline-success" @onclick="YeniAsync">Yeni plan</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_secili is null)" @onclick="KopyalaAsync">Kopyala</button>
            <span class="small text-muted ms-auto">Sağ tık: işlemler</span>
        </div>
    </section>

    <section class="border rounded bg-white">
        @if (_secili is null)
        {
            <p class="text-muted p-3">Soldan bir plan seçin.</p>
        }
        else
        {
            var v = _secili;
            <ul class="nav nav-tabs small px-1 pt-1">
                <li class="nav-item"><a class="nav-link @(_sekme == "hesap" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => _sekme = "hesap"'>Hesap Prm</a></li>
                <li class="nav-item"><a class="nav-link @(_sekme == "mola" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => _sekme = "mola"'>Mola Saatleri</a></li>
                <li class="nav-item"><a class="nav-link @(_sekme == "diger" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => _sekme = "diger"'>Diğer Prm</a></li>
            </ul>
            <div class="p-3 small">
            @if (_sekme == "hesap")
            {
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-2"><label class="form-label mb-0">Kod</label><input class="form-control form-control-sm" @bind="v.Kod" /></div>
                    <div class="col-md-6"><label class="form-label mb-0">Plan adı</label><input class="form-control form-control-sm" @bind="v.Ad" /></div>
                    <div class="col-md-2"><label class="form-check m-0"><input class="form-check-input" type="checkbox" @bind="v.Aktif" /> Aktif</label></div>
                </div>
                <div class="kirmizi-baslik px-0">ÇALIŞMA SAATLERİ</div>
                <table class="table table-sm table-bordered align-middle mb-1" style="max-width:760px">
                    <thead><tr><th>İ.G.S</th><th>D.Ç.S</th><th>G.G.T (dk)</th><th>E.Ç.T (dk)</th><th>Minimum FM (dk)</th></tr></thead>
                    <tbody><tr>
                        <td><input class="form-control form-control-sm" type="time" @bind="v.Baslangic" /></td>
                        <td><input class="form-control form-control-sm" type="time" @bind="v.Bitis" /></td>
                        <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.GecKalmaToleransDakika" /></td>
                        <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.ErkenCikmaToleransDakika" /></td>
                        <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.FazlaMesaiEsikDakika" /></td>
                    </tr></tbody>
                </table>
                <p class="text-muted mb-3">İ.G.S: içeri giriş saati · D.Ç.S: dışarı çıkış saati (girişten küçükse ertesi gün, gece vardiyası) · G.G.T / E.Ç.T: geç gelme / erken çıkma toleransı · Minimum FM: bundan az fazla mesai yazılmaz. Planlanan net süre: <b>@S(v.Kural().PlanlananDakika(Ornek))</b></p>

                <div class="kirmizi-baslik px-0">MOLA</div>
                @if (v.Molalar.Count == 0)
                {
                    <div class="d-flex align-items-center gap-2 mb-2"><span>Mola süresi (dk, 4 saati aşan çalışmadan düşülür)</span><input class="form-control form-control-sm" style="width:6rem" type="number" min="0" @bind="v.MolaDakika" />
                        <a href="" class="small" @onclick:preventDefault @onclick='() => _sekme = "mola"'>Mola saatlerini tanımla →</a></div>
                }
                else
                {
                    <p class="mb-2">@v.Molalar.Count mola saati tanımlı (@MolaOzeti(v)).
                        <a href="" @onclick:preventDefault @onclick='() => _sekme = "mola"'>Mola Saatleri sekmesi →</a></p>
                }

            }
            else if (_sekme == "mola")
            {
                <div class="kirmizi-baslik px-0">MOLA SAATLERİ (@v.Ad, @v.Baslangic.ToString("HH:mm")-@v.Bitis.ToString("HH:mm"))</div>
                <table class="table table-sm table-bordered table-hover align-middle mb-1" style="max-width:820px">
                    <thead><tr><th>Mola adı</th><th>Başlama</th><th>Bitiş</th><th>Süre</th><th>Tipi</th><th>Denk geldiği</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var m in v.Molalar)
                        {
                            var mola = m;
                            <tr @oncontextmenu="e => _menu.Ac(e, MolaMenusu(mola))" @oncontextmenu:preventDefault="true">
                                <td><input class="form-control form-control-sm" @bind="mola.Ad" /></td>
                                <td><input class="form-control form-control-sm" type="time" @bind="mola.Baslangic" /></td>
                                <td><input class="form-control form-control-sm" type="time" @bind="mola.Bitis" /></td>
                                <td class="text-end">@S(mola.Dakika)</td>
                                <td><select class="form-select form-select-sm" @bind="mola.Ucretli"><option value="false">Ücretsiz (düşülür)</option><option value="true">Ücretli (düşülmez)</option></select></td>
                                <td class="small text-muted">@MolaYeri(v, mola)</td>
                                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => v.Molalar.Remove(mola)">Sil</button></td>
                            </tr>
                        }
                        @if (v.Molalar.Count == 0)
                        {
                            <tr @oncontextmenu="e => _menu.Ac(e, MolaMenusu(null))" @oncontextmenu:preventDefault="true">
                                <td colspan="7" class="text-muted">Mola saati tanımlı değil. Aşağıdan ekleyin ya da sağ tıklayın.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="d-flex gap-2 flex-wrap mb-2">
                    <button class="btn btn-sm btn-outline-success" @onclick="MolaEkle">Mola ekle</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => HazirMola("Öğle yemeği", 12, 0, 13, 0, false)'>+ Öğle 12:00-13:00</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => HazirMola("Akşam yemeği", 19, 0, 19, 30, false)'>+ Akşam 19:00-19:30</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => HazirMola("Gece yemeği", 0, 0, 0, 30, false)'>+ Gece 00:00-00:30</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => HazirMola("Çay molası", 10, 0, 10, 15, true)'>+ Çay 10:00-10:15 (ücretli)</button>
                    <button class="btn btn-sm btn-outline-primary ms-auto" disabled="@(v.Molalar.Count == 0)" @onclick="() => _uygulaAcik = !_uygulaAcik">Bu molaları başka planlara uygula…</button>
                </div>
                @if (_uygulaAcik)
                {
                    <div class="border rounded p-2 mb-2 bg-light" style="max-width:820px">
                        <div class="fw-semibold mb-1">Molaları uygula (seçilen planların molaları bunlarla değiştirilir)</div>
                        @foreach (var d in _liste.Where(x => x.Id != v.Id))
                        {
                            var diger = d;
                            <label class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" checked="@_uygulanacak.Contains(diger.Id)"
                                       @onchange="e => { if (e.Value is true) _uygulanacak.Add(diger.Id); else _uygulanacak.Remove(diger.Id); }" />
                                @diger.Ad
                            </label>
                        }
                        <div class="mt-1 d-flex gap-2">
                            <button class="btn btn-sm btn-link p-0" @onclick="() => { _uygulanacak = _liste.Where(x => x.Id != v.Id).Select(x => x.Id).ToHashSet(); }">tümünü seç</button>
                            <button class="btn btn-sm btn-primary" disabled="@(_uygulanacak.Count == 0)" @onclick="MolalariUygulaAsync">Uygula (@_uygulanacak.Count plan)</button>
                        </div>
                    </div>
                }
                <p class="text-muted mb-0">
                    Ücretsiz molalar, personel o saatte içerideyse çalışmadan düşülür. Normal mesai içindeki mola normal çalışmadan,
                    fazla mesai saatlerine denk gelen mola (ör. gece yemeği) fazla mesaiden düşülür. Molanın ortasında çıkan personelde
                    yalnız içeride geçen kısmı düşülür. Ücretli molalar düşülmez. Mola tanımlı değilse "Hesap Prm" sekmesindeki mola süresi düşülür.
                    Değişiklikleri <b>Kaydet</b> ile kaydedin.
                </p>
            }
            else
            {
                <div class="row g-3" style="max-width:860px">
                    <div class="col-md-6">
                        <div class="border rounded p-2 h-100">
                            <div class="fw-semibold mb-1">Gün olarak devamsızlık cezası</div>
                            <div class="d-flex align-items-center gap-2"><span>Devamsızlık cezası</span><SureKutusu @bind-Dakika="DevamsizlikCezasi" /></div>
                            <div class="text-muted mt-1">Örn. günde 08:00 çalışılıyor ve 1'e 2 kesilmesi isteniyorsa 16:00 yazın. Boş (0:00) ise günlük süre kadar kesilir.</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-2 h-100">
                            <div class="fw-semibold mb-1">Geç / erken / eksik cezası (katsayı)</div>
                            <div class="row g-1 align-items-center">
                                <span class="col-4">Geç</span><div class="col-8"><input class="form-control form-control-sm" style="width:6rem" type="number" step="0.5" min="0" @bind="v.GecCezaKatsayisi" /></div>
                                <span class="col-4">Erken</span><div class="col-8"><input class="form-control form-control-sm" style="width:6rem" type="number" step="0.5" min="0" @bind="v.ErkenCezaKatsayisi" /></div>
                                <span class="col-4">Eksik</span><div class="col-8"><input class="form-control form-control-sm" style="width:6rem" type="number" step="0.5" min="0" @bind="v.EksikCezaKatsayisi" /></div>
                            </div>
                            <div class="text-muted mt-1">Ne kadar geç / erken / eksik kaldıysa bu katı kesilir (1 = aynısı, 2 = iki katı).</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="border rounded p-2">
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="v.NormalTamamlaSonraFazlaMesai" /> Normal çalışmayı tamamla, sonra fazla mesai ver (geç / erken iptal olur)</label>
                            <label class="form-check"><input class="form-check-input" type="checkbox" @bind="v.CokluGiriseEksikYazma" /> Aynı güne ait birden fazla giriş-çıkış varsa eksik süreyi yoksay</label>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span>Max tolerans (dk)</span><input class="form-control form-control-sm" style="width:6rem" type="number" min="0" @bind="v.MaxToleransDakika" />
                                <span class="text-muted">Giriş ile İ.G.S arasındaki fark bundan küçükse giriş saati İ.G.S kabul edilir. 0 = kapalı.</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                <span>Gün dönümü (gün atımı)</span><input class="form-control form-control-sm" style="width:7rem" type="time" @bind="v.GunDonumu" />
                                @if (v.GunDonumu is not null) { <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => v.GunDonumu = null">otomatik yap</button> }
                                <span class="text-muted">Bu saatten önceki okutmalar önceki güne yazılır (ör. 06:00: 08:30 giriş, gece 05:30 çıkış aynı gün; 18:30 sonrası mesai). Boş = otomatik: giriş açık kaldıysa ertesi sabahki çıkış (sonraki vardiyadan 2 saat öncesine kadar) aynı güne yazılır.</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-sm btn-primary px-4" @onclick="KaydetAsync">Kaydet</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Sec(v.Id)">Vazgeç</button>
            </div>
            </div>
        }
    </section>
</div>

<SagTikMenu @ref="_menu" />

@code {
    private static readonly DateOnly Ornek = new(2000, 1, 3);
    private SagTikMenu _menu = default!;
    private List<Vardiya> _liste = new();
    private Vardiya? _secili;
    private string _sekme = "hesap";
    private bool _uygulaAcik;
    private HashSet<int> _uygulanacak = new();

    [SupplyParameterFromQuery(Name = "sekme")] public string? SekmeParametresi { get; set; }
    private string? _hata, _bilgi;

    private static string S(int dk) => PuantajMotoru.SaatDakika(dk);

    private int DevamsizlikCezasi
    {
        get => _secili?.DevamsizlikCezaDakika ?? 0;
        set { if (_secili is not null) _secili.DevamsizlikCezaDakika = value > 0 ? value : null; }
    }

    protected override Task OnInitializedAsync()
    {
        if (SekmeParametresi is "hesap" or "mola" or "diger") _sekme = SekmeParametresi;
        return YukleAsync();
    }

    private async Task YukleAsync(int? secilecek = null)
    {
        await using var db = await FirmaDb.AcAsync();
        _liste = await db.Vardiyalar.AsNoTracking().Include(v => v.Molalar)
            .OrderByDescending(v => v.Aktif).ThenBy(v => v.Ad).ToListAsync();
        if (secilecek is int id) Sec(id);
        else if (_secili is null && _liste.Count > 0) Sec(_liste[0].Id);
    }

    private void Sec(int id)
    {
        var kaynak = _liste.FirstOrDefault(x => x.Id == id);
        if (kaynak is null) return;
        // Düzenleme kopya üzerinde yapılır; "Vazgeç" kaydedilmemiş değişiklikleri atar.
        _secili = Kopya(kaynak);
        _secili.Id = kaynak.Id;
        _hata = _bilgi = null;
    }

    private static Vardiya Kopya(Vardiya k) => new()
    {
        Kod = k.Kod, Ad = k.Ad, Aktif = k.Aktif, Baslangic = k.Baslangic, Bitis = k.Bitis, MolaDakika = k.MolaDakika,
        GecKalmaToleransDakika = k.GecKalmaToleransDakika, ErkenCikmaToleransDakika = k.ErkenCikmaToleransDakika,
        FazlaMesaiEsikDakika = k.FazlaMesaiEsikDakika, DevamsizlikCezaDakika = k.DevamsizlikCezaDakika,
        GecCezaKatsayisi = k.GecCezaKatsayisi, ErkenCezaKatsayisi = k.ErkenCezaKatsayisi, EksikCezaKatsayisi = k.EksikCezaKatsayisi,
        NormalTamamlaSonraFazlaMesai = k.NormalTamamlaSonraFazlaMesai, CokluGiriseEksikYazma = k.CokluGiriseEksikYazma,
        MaxToleransDakika = k.MaxToleransDakika, GunDonumu = k.GunDonumu,
        Molalar = k.Molalar.Select(m => new VardiyaMola { Ad = m.Ad, Baslangic = m.Baslangic, Bitis = m.Bitis, Ucretli = m.Ucretli }).ToList(),
    };

    private List<SagTikMenu.Oge> Menu() => new()
    {
        new("Yeni plan", YeniAsync),
        new("Seçili planı kopyala", KopyalaAsync),
        SagTikMenu.Oge.Eylemli("Hesap parametreleri", () => _sekme = "hesap"),
        SagTikMenu.Oge.Eylemli("Mola saatleri", () => _sekme = "mola"),
        SagTikMenu.Oge.Eylemli("Diğer parametreler", () => _sekme = "diger"),
        SagTikMenu.Oge.Cizgi(),
        new("Yenile", () => YukleAsync()),
    };

    private void MolaEkle() => _secili?.Molalar.Add(new VardiyaMola { Ad = "Mola", Baslangic = new TimeOnly(12, 0), Bitis = new TimeOnly(13, 0) });

    private static string MolaOzeti(Vardiya v) =>
        string.Join(", ", v.Molalar.Select(m => m.Ad + " " + m.Baslangic.ToString("HH:mm") + "-" + m.Bitis.ToString("HH:mm") + (m.Ucretli ? " (ücretli)" : "")));

    private void HazirMola(string ad, int s1, int d1, int s2, int d2, bool ucretli) =>
        _secili?.Molalar.Add(new VardiyaMola { Ad = ad, Baslangic = new TimeOnly(s1, d1), Bitis = new TimeOnly(s2, d2), Ucretli = ucretli });

    /// <summary>Molanın vardiyanın normal saatine mi, fazla mesaiye mi denk geldiği.</summary>
    private static string MolaYeri(Vardiya v, VardiyaMola m)
    {
        if (m.Baslangic == m.Bitis) return "";
        var k = v.Kural() with { Molalar = new[] { (m.Baslangic, m.Bitis) } };
        var icinde = k.MolaOrtusmesi(k.BaslangicZamani(Ornek), k.BitisZamani(Ornek));
        return icinde >= m.Dakika ? "normal mesai" : icinde == 0 ? "fazla mesai / vardiya dışı" : "kısmen normal mesai";
    }

    private List<SagTikMenu.Oge> MolaMenusu(VardiyaMola? m) => new()
    {
        SagTikMenu.Oge.Eylemli("Mola ekle", MolaEkle),
        SagTikMenu.Oge.Eylemli("Molayı sil", () => { if (m is not null) _secili?.Molalar.Remove(m); }, pasif: m is null),
        SagTikMenu.Oge.Eylemli(m?.Ucretli == true ? "Ücretsiz yap (düşülsün)" : "Ücretli yap (düşülmesin)", () => { if (m is not null) m.Ucretli = !m.Ucretli; }, pasif: m is null),
        SagTikMenu.Oge.Cizgi(),
        SagTikMenu.Oge.Eylemli("Başka planlara uygula…", () => _uygulaAcik = true, pasif: _secili is null || _secili.Molalar.Count == 0),
        new("Kaydet", KaydetAsync),
    };

    private async Task MolalariUygulaAsync()
    {
        if (_secili is null || _uygulanacak.Count == 0) return;
        if (_secili.Molalar.Any(m => string.IsNullOrWhiteSpace(m.Ad) || m.Baslangic == m.Bitis)) { _hata = "Her molanın adı olmalı; başlama ve bitiş farklı olmalı."; return; }
        await using var db = await FirmaDb.AcAsync();
        var hedefler = await db.Vardiyalar.Include(x => x.Molalar).Where(x => _uygulanacak.Contains(x.Id)).ToListAsync();
        foreach (var h in hedefler)
        {
            db.VardiyaMolalari.RemoveRange(h.Molalar);
            h.Molalar = _secili.Molalar.Select(m => new VardiyaMola { Ad = m.Ad.Trim(), Baslangic = m.Baslangic, Bitis = m.Bitis, Ucretli = m.Ucretli }).ToList();
            var k = h.Kural();
            h.MolaDakika = k.MolaOrtusmesi(k.BaslangicZamani(Ornek), k.BitisZamani(Ornek));
        }
        await db.SaveChangesAsync();
        var id = _secili.Id;
        _uygulaAcik = false;
        _uygulanacak.Clear();
        await YukleAsync(id);
        _bilgi = $"Molalar {hedefler.Count} plana uygulandı: {string.Join(", ", hedefler.Select(x => x.Ad))}.";
    }

    private async Task YeniAsync()
    {
        await using var db = await FirmaDb.AcAsync();
        var v = new Vardiya { Ad = "Yeni plan 08:00-17:00" };
        db.Vardiyalar.Add(v);
        await db.SaveChangesAsync();
        await YukleAsync(v.Id);
    }

    private async Task KopyalaAsync()
    {
        if (_secili is null) return;
        await using var db = await FirmaDb.AcAsync();
        var v = Kopya(_secili);
        v.Ad = _secili.Ad + " (kopya)";
        db.Vardiyalar.Add(v);
        await db.SaveChangesAsync();
        await YukleAsync(v.Id);
    }

    private async Task KaydetAsync()
    {
        _hata = _bilgi = null;
        var v = _secili;
        if (v is null) return;
        if (string.IsNullOrWhiteSpace(v.Ad)) { _hata = "Plan adı boş olamaz."; return; }
        if (v.MolaDakika < 0 || v.GecKalmaToleransDakika < 0 || v.ErkenCikmaToleransDakika < 0 || v.FazlaMesaiEsikDakika < 0 || v.MaxToleransDakika < 0)
        { _hata = "Süreler negatif olamaz."; return; }
        if (v.GecCezaKatsayisi < 0 || v.ErkenCezaKatsayisi < 0 || v.EksikCezaKatsayisi < 0 || v.GecCezaKatsayisi > 10 || v.ErkenCezaKatsayisi > 10 || v.EksikCezaKatsayisi > 10)
        { _hata = "Ceza katsayıları 0 ile 10 arasında olmalı."; return; }
        if (v.Molalar.Any(m => string.IsNullOrWhiteSpace(m.Ad) || m.Baslangic == m.Bitis)) { _hata = "Her molanın adı olmalı; başlama ve bitiş farklı olmalı."; return; }
        // Mola süresi alanı: vardiya saatleri içine düşen ücretsiz molalar (fazla mesaideki molalar puantajda ayrıca düşülür).
        if (v.Molalar.Count > 0) { var k0 = v.Kural(); v.MolaDakika = k0.MolaOrtusmesi(k0.BaslangicZamani(Ornek), k0.BitisZamani(Ornek)); }
        if (v.Kural().PlanlananDakika(Ornek) <= 0) { _hata = "Mola, çalışma süresinden uzun olamaz."; return; }

        await using var db = await FirmaDb.AcAsync();
        var k = await db.Vardiyalar.Include(x => x.Molalar).FirstOrDefaultAsync(x => x.Id == v.Id);
        if (k is null) { _hata = "Kayıt bulunamadı."; return; }
        k.Kod = string.IsNullOrWhiteSpace(v.Kod) ? null : v.Kod.Trim();
        k.Ad = v.Ad.Trim();
        k.Aktif = v.Aktif;
        k.Baslangic = v.Baslangic;
        k.Bitis = v.Bitis;
        k.MolaDakika = v.MolaDakika;
        k.GecKalmaToleransDakika = v.GecKalmaToleransDakika;
        k.ErkenCikmaToleransDakika = v.ErkenCikmaToleransDakika;
        k.FazlaMesaiEsikDakika = v.FazlaMesaiEsikDakika;
        k.DevamsizlikCezaDakika = v.DevamsizlikCezaDakika;
        k.GecCezaKatsayisi = v.GecCezaKatsayisi;
        k.ErkenCezaKatsayisi = v.ErkenCezaKatsayisi;
        k.EksikCezaKatsayisi = v.EksikCezaKatsayisi;
        k.NormalTamamlaSonraFazlaMesai = v.NormalTamamlaSonraFazlaMesai;
        k.CokluGiriseEksikYazma = v.CokluGiriseEksikYazma;
        k.MaxToleransDakika = v.MaxToleransDakika;
        k.GunDonumu = v.GunDonumu;
        db.VardiyaMolalari.RemoveRange(k.Molalar);
        k.Molalar = v.Molalar.Select(m => new VardiyaMola { Ad = m.Ad.Trim(), Baslangic = m.Baslangic, Bitis = m.Bitis, Ucretli = m.Ucretli }).ToList();
        await db.SaveChangesAsync();
        await YukleAsync(k.Id);
        _bilgi = $"{k.Ad} kaydedildi.";
    }
}
