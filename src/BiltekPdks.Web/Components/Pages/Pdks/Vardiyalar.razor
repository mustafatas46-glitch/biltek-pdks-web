@page "/vardiyalar"
@inject FirmaDb FirmaDb

<h1 class="h3 mb-2">Vardiyalar</h1>
<p class="text-muted mb-4">Bitiş saati başlangıçtan küçükse vardiya ertesi güne taşar (gece vardiyası). Süreler dakikadır.</p>

@if (_hata is not null) { <div class="alert alert-danger">@_hata</div> }
@if (_bilgi is not null) { <div class="alert alert-success">@_bilgi</div> }

@if (_liste is null)
{
    <p class="text-muted">Yükleniyor…</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th style="width:80px">Kod</th><th>Ad</th><th style="width:120px">Başlangıç</th><th style="width:120px">Bitiş</th>
                <th style="width:90px">Mola</th><th style="width:90px">Geç tol.</th><th style="width:90px">Erken tol.</th>
                <th style="width:90px">FM eşiği</th><th style="width:70px">Aktif</th><th style="width:90px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _liste)
            {
                <tr>
                    <td><input class="form-control form-control-sm" @bind="v.Kod" /></td>
                    <td><input class="form-control form-control-sm" @bind="v.Ad" /></td>
                    <td><input class="form-control form-control-sm" type="time" @bind="v.Baslangic" /></td>
                    <td><input class="form-control form-control-sm" type="time" @bind="v.Bitis" /></td>
                    <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.MolaDakika" /></td>
                    <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.GecKalmaToleransDakika" /></td>
                    <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.ErkenCikmaToleransDakika" /></td>
                    <td><input class="form-control form-control-sm" type="number" min="0" @bind="v.FazlaMesaiEsikDakika" /></td>
                    <td><input class="form-check-input" type="checkbox" @bind="v.Aktif" /></td>
                    <td><button class="btn btn-sm btn-outline-primary" @onclick="() => KaydetAsync(v)">Kaydet</button></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <button class="btn btn-primary" @onclick="YeniAsync">Yeni vardiya</button>
}

@code {
    private List<Vardiya>? _liste;
    private string? _hata, _bilgi;

    protected override Task OnInitializedAsync() => YukleAsync();

    private async Task YukleAsync()
    {
        await using var db = await FirmaDb.AcAsync();
        _liste = await db.Vardiyalar.AsNoTracking().OrderByDescending(v => v.Aktif).ThenBy(v => v.Baslangic).ToListAsync();
    }

    private async Task YeniAsync()
    {
        await using var db = await FirmaDb.AcAsync();
        db.Vardiyalar.Add(new Vardiya { Ad = "Yeni vardiya" });
        await db.SaveChangesAsync();
        await YukleAsync();
    }

    private async Task KaydetAsync(Vardiya v)
    {
        _hata = _bilgi = null;
        if (string.IsNullOrWhiteSpace(v.Ad)) { _hata = "Ad boş olamaz."; return; }
        if (v.MolaDakika < 0 || v.GecKalmaToleransDakika < 0 || v.ErkenCikmaToleransDakika < 0 || v.FazlaMesaiEsikDakika < 0)
        { _hata = "Süreler negatif olamaz."; return; }
        if (v.Kural().PlanlananDakika(DateOnly.FromDateTime(DateTime.Today)) <= 0)
        { _hata = "Mola, vardiya süresinden uzun olamaz."; return; }

        await using var db = await FirmaDb.AcAsync();
        var kayit = await db.Vardiyalar.FirstOrDefaultAsync(x => x.Id == v.Id);
        if (kayit is null) { _hata = "Kayıt bulunamadı."; return; }
        kayit.Kod = string.IsNullOrWhiteSpace(v.Kod) ? null : v.Kod.Trim();
        kayit.Ad = v.Ad.Trim();
        kayit.Baslangic = v.Baslangic;
        kayit.Bitis = v.Bitis;
        kayit.MolaDakika = v.MolaDakika;
        kayit.GecKalmaToleransDakika = v.GecKalmaToleransDakika;
        kayit.ErkenCikmaToleransDakika = v.ErkenCikmaToleransDakika;
        kayit.FazlaMesaiEsikDakika = v.FazlaMesaiEsikDakika;
        kayit.Aktif = v.Aktif;
        await db.SaveChangesAsync();
        _bilgi = $"{kayit.Ad} kaydedildi.";
    }
}
