        if (p.YolUcreti is { } b) yield return Y(b, p.YolGunluk, "Yol");
        if (p.YemekUcreti is { } c) yield return Y(c, p.YemekGunluk, "Yemek");
        if (p.OzelUcret is { } d) yield return Y(d, p.OzelGunluk, "Özel");
    }

