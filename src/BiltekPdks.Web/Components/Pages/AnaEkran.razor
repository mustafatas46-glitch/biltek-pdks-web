    private async Task SecAsync(int id)
    {
        _seciliId = id;
        _silOnay = false;
        _mesaj = null;
        _duzenle = null;
        _seciliGun = null;
        await using var db = await FirmaDb.AcAsync();
        _secili = await db.Personeller.AsNoTracking()
            .Include(p => p.Sube).Include(p => p.Bolum).Include(p => p.Gorev).Include(p => p.CalismaGrubu)
            .Include(p => p.Servis).Include(p => p.Bolge).Include(p => p.Birim).Include(p => p.Takim).Include(p => p.Meslek)
            .FirstOrDefaultAsync(p => p.Id == id);
        _izinler = await db.Izinler.AsNoTracking().Include(i => i.IzinTuru)
            .Where(i => i.PersonelId == id).OrderByDescending(i => i.Baslangic).Take(200).ToListAsync();
        await PuantajYukleAsync();
    }

    private async Task PuantajYukleAsync()
    {
        _puantaj = null;
        _hareketler = new();
        if (_seciliId is not int id) return;
        await using var db = await FirmaDb.AcAsync();
        _puantaj = await PuantajServisi.AylikAsync(db, id, _ay.Year, _ay.Month);
        var bas = new DateTime(_ay.Year, _ay.Month, 1).AddDays(-1);
        var bit = bas.AddMonths(1).AddDays(3);
        _hareketler = await db.Hareketler.AsNoTracking()
            .Where(h => h.PersonelId == id && !h.Iptal && h.Zaman >= bas && h.Zaman < bit).ToListAsync();
        var ayBas = new DateOnly(_ay.Year, _ay.Month, 1);
        var aySon = ayBas.AddMonths(1).AddDays(-1);
        _kk = await db.KazancKesintiler.AsNoTracking().Include(k => k.KazancKesintiTuru)
            .Where(k => k.PersonelId == id && k.Tarih >= ayBas && k.Tarih <= aySon).OrderBy(k => k.Id).ToListAsync();
        _seciliKk = null;
    }

    private Task AyKaydirAsync(int ay)
    {
        _ay = _ay.AddMonths(ay);
        _seciliGun = null;
        return PuantajYukleAsync();
    }

