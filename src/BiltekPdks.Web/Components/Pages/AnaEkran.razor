@page "/"
@implements IAsyncDisposable
@using BiltekPdks.Domain.Puantaj
@using BiltekPdks.Infrastructure.Puantaj
@inject FirmaDb FirmaDb
@inject PuantajServisi PuantajServisi
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="ana-ekran">
    @* ---------- SOL: PERSONEL ---------- *@
    <section>
        <div class="izgara">
            <table class="table table-sm table-hover">
                <thead><tr><th>Kart No</th><th>Adı</th><th>Soyadı</th><th>Sicil No</th><th>İş Giriş</th><th>İş Çıkış</th></tr></thead>
                <tbody>
                    @foreach (var p in Suzulmus)
                    {
                        <tr class="@(p.Id == _seciliId ? "secili" : "")" @onclick="() => SecAsync(p.Id)"
                            @oncontextmenu="e => PersonelMenusuAsync(e, p.Id)" @oncontextmenu:preventDefault="true">
                            <td>@p.KartNo</td><td>@p.Ad</td><td>@p.Soyad</td><td>@p.SicilNo</td>
                            <td>@p.IseGiris.ToString("dd.MM.yyyy")</td><td>@p.Cikis?.ToString("dd.MM.yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="alt-cubuk">
            @foreach (var (deger, ad) in AramaAlanlari)
            {
                <label class="form-check form-check-inline m-0 small">
                    <input class="form-check-input" type="radio" name="aramaAlani" checked="@(_aramaAlani == deger)" @onchange="() => _aramaAlani = deger" /> @ad
                </label>
            }
            <input class="form-control form-control-sm flex-grow-1" style="min-width:120px" placeholder="ara…" @bind="_arama" @bind:event="oninput" @ref="_aramaKutusu" />
        </div>
        <div class="alt-cubuk">
            <button class="btn btn-sm btn-success" @onclick="Yeni">Yeni [F2]</button>
            <button class="btn btn-sm btn-primary" disabled="@(_seciliId is null)" @onclick="Degistir">Değiştir [F3]</button>
            <button class="btn btn-sm btn-outline-danger" disabled="@(_seciliId is null)" @onclick="SilAsync">@(_silOnay ? "Emin misiniz? Tekrar basın" : "Sil [F4]")</button>
            <select class="form-select form-select-sm ms-auto" style="width:auto" @bind="_durum">
                <option value="tum">Tümü</option><option value="aktif">Aktif</option><option value="pasif">Pasif</option>
            </select>
            <span class="small text-muted">Kayıt: @Suzulmus.Count()</span>
        </div>
        @if (_mesaj is not null) { <div class="alert alert-warning m-2 py-1 small">@_mesaj</div> }
        @if (_secili is not null)
        {
            <dl class="kart row m-0">
                <dt class="col-3">Grup</dt><dd class="col-3">@_secili.CalismaGrubu?.Ad</dd>
                <dt class="col-3">İş Baş. Tar.</dt><dd class="col-3">@_secili.IseGirisTarihi.ToString("dd.MM.yyyy")</dd>
                <dt class="col-3">Bölüm</dt><dd class="col-3">@_secili.Bolum?.Ad</dd>
                <dt class="col-3">İş Çık. Tar.</dt><dd class="col-3">@_secili.IstenCikisTarihi?.ToString("dd.MM.yyyy")</dd>
                <dt class="col-3">Görev</dt><dd class="col-3">@_secili.Gorev?.Ad</dd>
                <dt class="col-3">Cep Tel</dt><dd class="col-3">@_secili.CepTelefonu</dd>
                <dt class="col-3">Şube</dt><dd class="col-3">@_secili.Sube?.Ad</dd>
                <dt class="col-3">Mail</dt><dd class="col-3">@_secili.Eposta</dd>
                <dt class="col-3">Servis</dt><dd class="col-3">@_secili.Servis?.Ad</dd>
                <dt class="col-3">Maaş/S.Ücr</dt><dd class="col-3">@(_secili.Ucret is { } u ? u.ToString("N2") + (_secili.UcretTipi == UcretTipi.SaatUcreti ? " /saat" : "") : "")</dd>
                <dt class="col-3">Bölge</dt><dd class="col-3">@_secili.Bolge?.Ad</dd>
                <dt class="col-3">Kimlik No</dt><dd class="col-3">@_secili.TcKimlikNo</dd>
                <dt class="col-3">Birim</dt><dd class="col-3">@_secili.Birim?.Ad</dd>
                <dt class="col-3">Sicil No</dt><dd class="col-3">@_secili.SicilNo</dd>
                <dt class="col-3">Takım</dt><dd class="col-3">@_secili.Takim?.Ad</dd>
                <dt class="col-3">Meslek</dt><dd class="col-3">@_secili.Meslek?.Ad</dd>
            </dl>
        }
    </section>

    @* ---------- ORTA: SEKMELER ---------- *@
    <section>
        <ul class="nav nav-tabs small px-1 pt-1">
            <li class="nav-item"><a class="nav-link @(_sekme == "gc" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => _sekme = "gc"'>Giriş/Çıkış</a></li>
            <li class="nav-item"><a class="nav-link @(_sekme == "izin" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => _sekme = "izin"'>İzinler</a></li>
            <li class="nav-item"><a class="nav-link @(_sekme == "kk" ? "active" : "")" href="" @onclick:preventDefault @onclick='() => _sekme = "kk"'>Kazanç/Kesinti</a></li>
        </ul>

        @if (_sekme == "gc")
        {
            <div class="izgara">
                <table class="table table-sm table-hover">
                    <thead><tr><th>Giriş Tarihi</th><th>Gir.Saati</th><th>Çıkış Tarihi</th><th>Çık.Saati</th><th title="Giriş elle girildi">Gr.E</th><th title="Çıkış elle girildi">Çk.E</th></tr></thead>
                    <tbody>
                        @foreach (var g in GirisCikisSatirlari)
                        {
                            <tr class="@(g.Tarih == _seciliGun ? "secili" : "")" @onclick="() => GunSec(g.Tarih)"
                                @oncontextmenu="e => { GunSec(g.Tarih); _menu.Ac(e, HareketMenusu()); }" @oncontextmenu:preventDefault="true">
                                <td>@TarihMetni(g.Giris!.Value)</td><td>@g.Giris.Value.ToString("HH:mm")</td>
                                <td>@(g.Cikis is { } c ? TarihMetni(c) : "")</td><td>@g.Cikis?.ToString("HH:mm")</td>
                                <td>@(ElleMi(g.Giris) ? "E" : "")</td><td>@(ElleMi(g.Cikis) ? "E" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_duzenle is not null)
            {
                <div class="alt-cubuk bg-light">
                    <input class="form-control form-control-sm" style="width:9.5rem" type="date" @bind="_duzenle.Tarih" disabled="@(_duzenle.Mevcut)" />
                    <span class="small">Giriş</span><input class="form-control form-control-sm" style="width:6.5rem" type="time" @bind="_duzenle.Giris" />
                    <span class="small">Çıkış</span><input class="form-control form-control-sm" style="width:6.5rem" type="time" @bind="_duzenle.Cikis" />
                    <input class="form-control form-control-sm flex-grow-1" placeholder="Açıklama (zorunlu)" @bind="_duzenle.Aciklama" />
                    <button class="btn btn-sm btn-primary" @onclick="DuzenlemeyiKaydetAsync">Kaydet</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _duzenle = null">Vazgeç</button>
                </div>
            }
            <div class="alt-cubuk">
                <button class="btn btn-sm btn-outline-success" disabled="@(_secili is null)" @onclick="HareketEkle">Ekle</button>
                <button class="btn btn-sm btn-outline-primary" disabled="@(_seciliGun is null)" @onclick="HareketDegistir">Değiştir</button>
                <button class="btn btn-sm btn-outline-danger" disabled="@(_seciliGun is null)" @onclick="HareketSilAsync">@(_hareketSilOnay ? "Emin misiniz?" : "Sil")</button>
                <button class="btn btn-sm btn-outline-dark" disabled="@(_secili is null)" @onclick="() => TopluAcAsync(_seciliId!.Value)">Toplu ekle…</button>
                <span class="small text-muted ms-auto">Elle girilenler "E" ile işaretlenir.</span>
            </div>
        }
        else if (_sekme == "izin")
        {
            <div class="izgara">
                <table class="table table-sm">
                    <thead><tr><th>Başlangıç</th><th>Bitiş</th><th>Gün</th><th>Tür</th><th>Açıklama</th></tr></thead>
                    <tbody>
                        @foreach (var i in _izinler)
                        {
                            <tr @oncontextmenu="e => _menu.Ac(e, IzinMenusu())" @oncontextmenu:preventDefault="true"><td>@i.Baslangic.ToString("dd.MM.yyyy")</td><td>@i.Bitis.ToString("dd.MM.yyyy")</td>
                                <td>@(i.Bitis.DayNumber - i.Baslangic.DayNumber + 1)</td><td>@i.IzinTuru?.Ad</td><td>@i.Aciklama</td></tr>
                        }
                    </tbody>
                </table>
                @if (_secili is not null && _izinler.Count == 0) { <p class="text-muted small p-2">İzin kaydı yok.</p> }
            </div>
            <div class="alt-cubuk"><a class="btn btn-sm btn-outline-success" href="izinler">İzin ekle…</a></div>
        }
        else
        {
            <div class="izgara">
                <table class="table table-sm table-hover">
                    <thead><tr><th>Tarih</th><th>Kalem</th><th>Tip</th><th class="text-end">Tutar</th><th>Açıklama</th></tr></thead>
                    <tbody>
                        @foreach (var k in _kk)
                        {
                            <tr class="@(k.Id == _seciliKk ? "secili" : "")" @onclick="() => _seciliKk = k.Id"
                                @oncontextmenu="e => { _seciliKk = k.Id; _menu.Ac(e, KkMenusu()); }" @oncontextmenu:preventDefault="true">
                                <td>@k.Tarih.ToString("MM.yyyy")</td><td>@k.KazancKesintiTuru?.Ad</td>
                                <td>@(k.KazancKesintiTuru is { } tur ? Pages.Toplu.TopluKazancKesinti.TipAdi(tur.Tip) : "")</td>
                                <td class="text-end">@k.Tutar.ToString("N2")</td><td>@k.Aciklama</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_secili is not null && _kk.Count == 0) { <p class="text-muted small p-2">@_ay.ToString("MM.yyyy") ayı için kayıt yok.</p> }
                @if (_secili is not null && SabitKalemler().Any())
                {
                    <div class="small text-muted px-2">Sicil kartındaki sabit kalemler: @string.Join(" · ", SabitKalemler())</div>
                }
            </div>
            <div class="alt-cubuk">
                <select class="form-select form-select-sm" style="width:9rem" @bind="_kkTurId">
                    <option value="0">Kalem…</option>
                    @foreach (var t in _kkTurleri) { <option value="@t.Id">@t.Ad</option> }
                </select>
                <input class="form-control form-control-sm" style="width:6.5rem" type="number" step="0.01" min="0" placeholder="Tutar" @bind="_kkTutar" />
                <input class="form-control form-control-sm flex-grow-1" style="min-width:6rem" placeholder="Açıklama" @bind="_kkAciklama" />
                <button class="btn btn-sm btn-outline-success" disabled="@(_secili is null)" @onclick="KkEkleAsync">Ekle</button>
                <button class="btn btn-sm btn-outline-danger" disabled="@(_seciliKk is null)" @onclick="KkSilAsync">Sil</button>
            </div>
        }
    </section>

    @* ---------- SAĞ: GÜNLÜK PUANTAJ ---------- *@
    <section>
        <div class="izgara">
            <table class="table table-sm">
                <thead><tr><th>Tarih</th><th>Giriş</th><th>Çıkış</th><th>N.Ç</th><th>%50</th><th>%100</th><th>DVM</th><th>GEÇ</th><th>ERK</th><th>EKS</th></tr></thead>
                <tbody>
                    @if (_puantaj is not null)
                    {
                        @foreach (var g in _puantaj.Gunler)
                        {
                            <tr class="puantaj-satir @SatirSinifi(g) @(g.Tarih == _seciliGun ? "secili" : "")" @onclick="() => GunSec(g.Tarih)"
                                @oncontextmenu="e => { GunSec(g.Tarih); _menu.Ac(e, PuantajMenusu()); }" @oncontextmenu:preventDefault="true">
                                <td>@TarihMetni(g.Tarih.ToDateTime(TimeOnly.MinValue))</td>
                                <td>@g.Giris?.ToString("HH:mm")</td><td>@g.Cikis?.ToString("HH:mm")</td>
                                <td>@S(g.NormalCalismaDakika)</td><td>@S(g.FazlaMesaiDakika)</td><td>@S(g.TatilMesaisiDakika)</td>
                                <td>@(g.Durum == PuantajDurumu.Devamsiz ? S(g.EksikDakika) : "")</td>
                                <td>@S(g.GecKalmaDakika)</td><td>@S(g.ErkenCikmaDakika)</td>
                                <td>@(g.Durum == PuantajDurumu.Devamsiz ? "" : S(g.EksikDakika))</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (_puantaj is not null)
                {
                    var t = _puantaj.Toplam;
                    <tfoot><tr class="fw-semibold"><td colspan="3">Toplam</td><td>@S(t.NormalCalismaDakika)</td><td>@S(t.FazlaMesaiDakika)</td><td>@S(t.TatilMesaisiDakika)</td>
                        <td>@(t.DevamsizGun > 0 ? $"{t.DevamsizGun} gün" : "")</td><td>@S(t.GecKalmaDakika)</td><td>@S(t.ErkenCikmaDakika)</td><td>@S(t.EksikDakika)</td></tr></tfoot>
                }
            </table>
            @if (_secili is null) { <p class="text-muted small p-2">Puantajı görmek için soldan personel seçin.</p> }
        </div>
        <div class="alt-cubuk">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AyKaydirAsync(-1)">‹‹‹</button>
            <input class="form-control form-control-sm" style="width:10rem" type="month" @bind="_ay" @bind:format="yyyy-MM" @bind:after="PuantajYukleAsync" />
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => AyKaydirAsync(1)">›››</button>
            <button class="btn btn-sm btn-primary" @onclick="PuantajYukleAsync">Göster [F8]</button>
            <button class="btn btn-sm btn-outline-primary" disabled="@(_seciliId is null)" @onclick="KisiselPuantajAc">Kişisel puantaj [F9]</button>
            <button class="btn btn-sm btn-outline-success" disabled="@(_seciliId is null)" @onclick="RaporAl">Rapor [F10]</button>
            <span class="lejant small ms-auto"><span style="background:#c9cdd2"></span>devamsız<span style="background:#9cc7f2"></span>eksik hareket<span style="background:#fff27a"></span>geç<span style="background:#f5a3e6"></span>erken</span>
        </div>
    </section>
</div>

<SagTikMenu @ref="_menu" />

@if (_toplu is not null)
{
    <div class="pdks-pencere-arka" @onclick="() => _toplu = null"></div>
    <div class="pdks-pencere" role="dialog" aria-label="Toplu giriş-çıkış">
        <div class="d-flex align-items-center mb-2">
            <h2 class="h6 m-0">Toplu giriş-çıkış — @_toplu.PersonelAdi</h2>
            <button class="btn-close ms-auto" aria-label="Kapat" @onclick="() => _toplu = null"></button>
        </div>
        <div class="row g-2">
            <div class="col-6"><label class="form-label small mb-0">Başlangıç tarihi</label><input class="form-control form-control-sm" type="date" @bind="_toplu.Baslangic" /></div>
            <div class="col-6"><label class="form-label small mb-0">Bitiş tarihi</label><input class="form-control form-control-sm" type="date" @bind="_toplu.Bitis" /></div>
            <div class="col-12 d-flex gap-1 flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => TopluAralik(0)">Bugün</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => TopluAralik(7)">Bu hafta</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => TopluAralik(30)">Seçili ay</button>
            </div>
            <div class="col-6"><label class="form-label small mb-0">Giriş saati</label><input class="form-control form-control-sm" type="time" @bind="_toplu.Giris" /></div>
            <div class="col-6"><label class="form-label small mb-0">Çıkış saati</label><input class="form-control form-control-sm" type="time" @bind="_toplu.Cikis" /></div>
            <div class="col-12 small">
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_toplu.YalnizCalismaGunleri" /> Yalnız çalışma günleri (hafta tatillerini atla)</label>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_toplu.ResmiTatilleriAtla" /> Resmi tatilleri atla</label>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_toplu.IzinliGunleriAtla" /> İzinli günleri atla</label>
                <label class="form-check"><input class="form-check-input" type="checkbox" @bind="_toplu.HareketiOlanGunleriAtla" /> Zaten giriş-çıkışı olan günleri atla</label>
            </div>
            <div class="col-12"><input class="form-control form-control-sm" placeholder="Açıklama (zorunlu)" @bind="_toplu.Aciklama" /></div>
        </div>
        @if (_toplu.Mesaj is not null) { <div class="alert @(_toplu.Hata ? "alert-danger" : "alert-success") py-1 small mt-2 mb-0">@_toplu.Mesaj</div> }
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-sm btn-outline-primary" @onclick="() => TopluCalistirAsync(true)">Önizle</button>
            <button class="btn btn-sm btn-success" @onclick="() => TopluCalistirAsync(false)">Ekle</button>
            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => _toplu = null">Kapat</button>
        </div>
    </div>
}

@code {
    private static readonly (string Deger, string Ad)[] AramaAlanlari = { ("kart", "Kart No"), ("ad", "Adı"), ("soyad", "Soyadı"), ("sicil", "Sicil No") };

    private sealed record PersonelSatiri(int Id, string KartNo, string Ad, string Soyad, string? SicilNo, DateOnly IseGiris, DateOnly? Cikis);

    private sealed class HareketDuzenleme
    {
        public DateOnly? Tarih { get; set; }
        public TimeOnly? Giris { get; set; }
        public TimeOnly? Cikis { get; set; }
        public string? Aciklama { get; set; }
        public bool Mevcut { get; set; }
        public DateTime? EskiGiris { get; set; }
        public DateTime? EskiCikis { get; set; }
    }

    private List<PersonelSatiri> _liste = new();
    private string _aramaAlani = "ad", _arama = "", _durum = "aktif", _sekme = "gc";
    private int? _seciliId;
    private Personel? _secili;
    private DateTime _ay = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private AylikPuantaj? _puantaj;
    private List<Hareket> _hareketler = new();
    private List<Izin> _izinler = new();
    private DateOnly? _seciliGun;
    private HareketDuzenleme? _duzenle;
    private bool _silOnay, _hareketSilOnay;
    private string? _mesaj;
    private DotNetObjectReference<AnaEkran>? _ref;
    private TopluForm? _toplu;
    private SagTikMenu _menu = default!;
    private ElementReference _aramaKutusu;
    private string _siralama = "kart";
    private List<KazancKesinti> _kk = new();
    private List<KazancKesintiTuru> _kkTurleri = new();
    private int? _seciliKk;
    private int _kkTurId;
    private decimal? _kkTutar;
    private string? _kkAciklama;

    private sealed class TopluForm
    {
        public int PersonelId { get; init; }
        public string PersonelAdi { get; init; } = "";
        public DateOnly Baslangic { get; set; }
        public DateOnly Bitis { get; set; }
        public TimeOnly Giris { get; set; } = new(8, 0);
        public TimeOnly Cikis { get; set; } = new(17, 0);
        public bool YalnizCalismaGunleri { get; set; } = true;
        public bool ResmiTatilleriAtla { get; set; } = true;
        public bool IzinliGunleriAtla { get; set; } = true;
        public bool HareketiOlanGunleriAtla { get; set; } = true;
        public string Aciklama { get; set; } = "Toplu giriş-çıkış";
        public string? Mesaj { get; set; }
        public bool Hata { get; set; }
    }

    private IEnumerable<PersonelSatiri> Suzulmus
    {
        get
        {
            var bugun = DateOnly.FromDateTime(DateTime.Today);
            var q = _durum switch
            {
                "aktif" => _liste.Where(p => p.Cikis is null || p.Cikis >= bugun),
                "pasif" => _liste.Where(p => p.Cikis is not null && p.Cikis < bugun),
                _ => _liste.AsEnumerable(),
            };
            q = _siralama switch
            {
                "ad" => q.OrderBy(p => p.Ad).ThenBy(p => p.Soyad),
                "soyad" => q.OrderBy(p => p.Soyad).ThenBy(p => p.Ad),
                "sicil" => q.OrderBy(p => p.SicilNo),
                "giris" => q.OrderBy(p => p.IseGiris),
                _ => q.OrderBy(p => p.KartNo),
            };
            var a = _arama.Trim();
            if (a.Length == 0) return q;
            var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
            bool Iceriyor(string? s) => s is not null && tr.CompareInfo.IndexOf(s, a, System.Globalization.CompareOptions.IgnoreCase) >= 0;
            return _aramaAlani switch
            {
                "kart" => q.Where(p => p.KartNo.Contains(a, StringComparison.OrdinalIgnoreCase)),
                "soyad" => q.Where(p => Iceriyor(p.Soyad)),
                "sicil" => q.Where(p => Iceriyor(p.SicilNo)),
                _ => q.Where(p => Iceriyor(p.Ad)),
            };
        }
    }

    private IEnumerable<GunlukPuantaj> GirisCikisSatirlari =>
        _puantaj?.Gunler.Where(g => g.Giris is not null) ?? Enumerable.Empty<GunlukPuantaj>();

    private static string S(int dk) => PuantajMotoru.SaatDakika(dk);

    private static string TarihMetni(DateTime t) =>
        t.ToString("dd MMM yyyy ddd", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    private bool ElleMi(DateTime? zaman) =>
        zaman is { } z && _hareketler.Any(h => h.Zaman == z && h.Kaynak == HareketKaynagi.Elle);

    private static string SatirSinifi(GunlukPuantaj g) => g.Durum switch
    {
        PuantajDurumu.Devamsiz => "devamsiz",
        PuantajDurumu.EksikHareket => "eksik",
        PuantajDurumu.HaftaTatili or PuantajDurumu.ResmiTatil => "tatil",
        PuantajDurumu.KapsamDisi => "kapsam",
        _ when g.ErkenCikmaDakika > 0 => "erken",
        _ when g.GecKalmaDakika > 0 => "gec",
        _ => "",
    };

    [SupplyParameterFromQuery(Name = "personel")] public int? PersonelParametresi { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ListeyiYukleAsync();
        await using (var db = await FirmaDb.AcAsync())
            _kkTurleri = await db.KazancKesintiTurleri.AsNoTracking().Where(t => t.Aktif).OrderBy(t => t.Ad).ToListAsync();
        if (PersonelParametresi is int id) await SecAsync(id);
    }

    protected override async Task OnAfterRenderAsync(bool ilk)
    {
        if (!ilk) return;
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pdksKisayol.bagla", _ref);
    }

    public async ValueTask DisposeAsync()
    {
        // Ön işleme (prerender) sırasında JS yoktur; yalnızca bağlandıysak bırak.
        if (_ref is not null)
            try { await JS.InvokeVoidAsync("pdksKisayol.birak"); } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        _ref?.Dispose();
    }

