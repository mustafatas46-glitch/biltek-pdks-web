    private async Task TopluAcAsync(int personelId)
    {
        if (personelId != _seciliId) await SecAsync(personelId);
        if (_secili is null) return;
        var ilk = new DateOnly(_ay.Year, _ay.Month, 1);
        var son = ilk.AddMonths(1).AddDays(-1);
        var bugun = DateOnly.FromDateTime(DateTime.Today);
        _toplu = new TopluForm
        {
            PersonelId = _secili.Id,
            PersonelAdi = $"{_secili.Ad} {_secili.Soyad}",
            Baslangic = ilk,
            Bitis = son > bugun && ilk <= bugun ? bugun : son,
        };
        // Saatler personelin çalışma grubundaki vardiyadan gelir.
        if (_secili.CalismaGrubuId is int gid)
        {
            await using var db = await FirmaDb.AcAsync();
            Vardiya? v = null;
            if (_secili.AltGrupId is int aid)
            {
                var vid = await db.AltGrupGunleri.AsNoTracking().Where(x => x.AltGrupId == aid && x.VardiyaId != null)
                    .OrderBy(x => x.Gun == DayOfWeek.Sunday ? 7 : (int)x.Gun).Select(x => x.VardiyaId).FirstOrDefaultAsync();
                if (vid is int id) v = await db.Vardiyalar.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
            }
            v ??= await db.CalismaGrubuGunleri.AsNoTracking().Where(x => x.CalismaGrubuId == gid && x.Vardiya != null)
                .OrderBy(x => x.Gun == DayOfWeek.Sunday ? 7 : (int)x.Gun).Select(x => x.Vardiya).FirstOrDefaultAsync();
            if (v is not null) { _toplu.Giris = v.Baslangic; _toplu.Cikis = v.Bitis; }
        }
    }

    private void TopluAralik(int gun)
    {
        if (_toplu is null) return;
        var bugun = DateOnly.FromDateTime(DateTime.Today);
        switch (gun)
        {
            case 0: _toplu.Baslangic = _toplu.Bitis = bugun; break;
            case 7:
                _toplu.Baslangic = bugun.AddDays(-(((int)bugun.DayOfWeek + 6) % 7));
                _toplu.Bitis = _toplu.Baslangic.AddDays(6);
                break;
            default:
                _toplu.Baslangic = new DateOnly(_ay.Year, _ay.Month, 1);
                _toplu.Bitis = _toplu.Baslangic.AddMonths(1).AddDays(-1);
                break;
        }
    }

    private async Task TopluCalistirAsync(bool deneme)
    {
        if (_toplu is null) return;
        var f = _toplu;
        try
        {
            await using var db = await FirmaDb.AcAsync();
            var sonuc = await TopluHareketServisi.EkleAsync(db,
                new TopluHareketIstegi(f.PersonelId, f.Baslangic, f.Bitis, f.Giris, f.Cikis, f.Aciklama,
                    f.YalnizCalismaGunleri, f.ResmiTatilleriAtla, f.HareketiOlanGunleriAtla, f.IzinliGunleriAtla),
                await FirmaDb.KullaniciIdAsync(), deneme);
            var atlanan = new List<string>();
            if (sonuc.HareketiOlan > 0) atlanan.Add($"{sonuc.HareketiOlan} gün zaten hareketli");
            if (sonuc.CalismaGunuDegil > 0) atlanan.Add($"{sonuc.CalismaGunuDegil} gün tatil/plansız");
            if (sonuc.ResmiTatil > 0) atlanan.Add($"{sonuc.ResmiTatil} gün resmi tatil");
            if (sonuc.Izinli > 0) atlanan.Add($"{sonuc.Izinli} gün izinli");
            if (sonuc.KapsamDisi > 0) atlanan.Add($"{sonuc.KapsamDisi} gün işe giriş/çıkış dışında");
            var ek = atlanan.Count > 0 ? $" Atlanan: {string.Join(", ", atlanan)}." : "";
            f.Hata = false;
            f.Mesaj = deneme
                ? $"{sonuc.EklenenGun} güne giriş-çıkış eklenecek.{ek}"
                : $"{sonuc.EklenenGun} güne giriş-çıkış eklendi.{ek}";
            if (!deneme) await PuantajYukleAsync();
        }
        catch (ArgumentException e)
        {
            f.Hata = true;
            f.Mesaj = e.Message;
        }
    }

    private void Degistir()
    {
